# Credentials & secrets
.credentials.json

# Honeypot harvest dirs — must never be tracked. Substring match so
# `quarantine`, `quarantine-old`, `container-staging/.../quarantine`,
# etc. are all covered.
**/*quarantine*

# Ephemeral state
history.jsonl
mcp-needs-auth-cache.json
dates/state.json
last-statusline.json

# Plugin runtime data
plugins/

# Homunculus runtime state (observer archives, PIDs, per-project memory)
# Skill content lives in ~/Repos/everything-claude-code/.claude/homunculus
homunculus/

# Scratch/tmp folder
tmp/

# Step-back detector runtime state (per-session flags + classifier log)
step-back/

# Runtime/cache directories
cache/
debug/
downloads/
backups/
file-history/
session-env/
shell-snapshots/
telemetry/
paste-cache/
sessions/
powerline/usage/today.json
powerline/usage/pricing.json

# Project-specific data (per-project, not global)
projects/

# Tasks & plans (session-specific) — anchored to root so dev-container/plans/ tracks
/tasks/
/plans/
**/__pycache__/

# Caveman state flag
.caveman-active

# Dev-container user-local overrides
dev-container/proxy-allow.txt

# Powerline / per-session usage telemetry
usage-data/

# Cron-driven log output. All runtime-emitted logs are ignored;
# hand-curated ones (review-agent.log) are negated back in.
logs/*.log
!logs/review-agent.log

# Externally cloned skill repos (each has its own .git; track upstream
# as submodules later if pinning becomes useful)
skills/caveman/
skills/planning-with-files/

# Python virtualenvs + build artefacts inside tools/
**/.venv/
tools/*/state.json

# Token-optimizer runtime (plugin data dir + backups)
token-optimizer/
_backups/

# Homunculus observer artefact
observer-last-run.log

# Claude Code session lockfile
.settings.lock

# Worker runtime state (scaffolded by CC on each run)
workers/.claude-profile/backups/
workers/.claude-profile/projects/
workers/.claude-profile/sessions/
workers/.claude-profile/.claude.json
workers/*/scratch/

# Local-only permissions (CC writes dynamically)
.claude/settings.local.json

# Credential backups (.credentials.json itself already ignored above; .bak-* variants too)
.credentials.json.bak-*

# Repo-autosync runtime state (per-repo cache, security alerts, logs)
repo-autosync-data/

# Scheduled-task lockfile (ephemeral)
scheduled_tasks.lock

# Cleanup timestamp (runtime)
.last-cleanup

# Auto-updater outcome stamp (runtime)
.last-update-result.json

# Home-manager-managed skill symlinks (point into /nix/store)
skills/nixos-config-dev
skills/nixos-vm-test-gate
skills/nixos-agent-testing
skills/nixos-automated-testing
skills/nixos-agenix-secret

# CI-stability monitoring runtime (per-PR logs + state)
loops/

# Prompt-log JSONL (populated by hooks/prompt-log.py) — high-churn,
# session-local. Skill /prompt-review-weekly clusters into backlog.
automation-review/
