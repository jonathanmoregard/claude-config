{
  "cleanupPeriodDays": 99999,
  "enableAllProjectMcpServers": false,
  "env": {
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },
  "permissions": {
    "allow": [
      "Bash",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(~/.claude/date-reset.sh)",
      "mcp__research-agent__*",
      "Write(/home/jonathan/.claude/homunculus/projects/ba55d347afb5/instincts/personal/**)",
      "Write(/home/jonathan/.claude/homunculus/projects/c087f65d08a2/instincts/personal/**)",
      "WebFetch(domain:docs.github.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:docs.python.org)",
      "WebFetch(domain:developer.mozilla.org)",
      "WebFetch(domain:docs.aws.amazon.com)"
    ],
    "deny": [
      "WebFetch",
      "WebSearch",
      "Bash(curl *)",
      "Bash(curl)",
      "Bash(wget *)",
      "Bash(wget)",
      "Bash(http *)",
      "Bash(https *)",
      "Bash(secret-tool*)",
      "Bash(docker exec research-agent*)",
      "Bash(docker exec -* research-agent*)",
      "Bash(docker inspect*research-agent*)",
      "Bash(docker logs*research-agent*)",
      "Bash(docker cp*research-agent*)",
      "Read(/home/jonathan/Repos/research-agent/.env)",
      "Read(/home/jonathan/Repos/research-agent/.env.*)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(sudo *)",
      "Bash(mkfs *)",
      "Bash(mkfs.*)",
      "Bash(dd *)",
      "Bash(wget *|bash*)",
      "Bash(wget *| bash*)",
      "Bash(curl *|bash*)",
      "Bash(curl *| bash*)",
      "Bash(curl *|sh*)",
      "Bash(curl *| sh*)",
      "Bash(git push --force*)",
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push *-f *)",
      "Bash(git reset --hard*)",
      "Edit(~/.bashrc)",
      "Edit(~/.zshrc)",
      "Edit(~/.ssh/**)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.git-credentials)",
      "Read(~/.docker/config.json)",
      "Read(~/.kube/**)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.gem/credentials)",
      "Read(~/.config/todo/env)",
      "Read(~/Dropbox/1. Exocortex/**)",
      "Edit(~/Dropbox/1. Exocortex/**)",
      "Write(~/Dropbox/1. Exocortex/**)",
      "Read(~/.local/share/keyrings/**)",
      "Read(~/.config/libsecret/**)",
      "Read(~/.local/share/kwalletd/**)",
      "Read(~/.kde/share/apps/kwallet/**)",
      "Read(~/.pki/**)",
      "Read(~/.password-store/**)",
      "Read(~/.mozilla/firefox/**)",
      "Read(~/.config/google-chrome/**)",
      "Read(~/.config/chromium/**)",
      "Read(~/.config/BraveSoftware/**)",
      "Read(~/.electrum/**)",
      "Read(~/.config/Exodus/**)",
      "Read(~/.ethereum/**)",
      "Read(~/.bitcoin/**)",
      "Read(~/.monero/**)",
      "Read(~/.config/Ledger Live/**)",
      "Read(~/.netrc)",
      "Read(~/.authinfo)",
      "Read(~/.authinfo.gpg)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.config/doctl/**)",
      "Read(~/.config/fly/**)",
      "Read(~/.config/rclone/rclone.conf)",
      "Read(~/.vault-token)",
      "Read(~/.config/vault/**)",
      "Read(~/.config/op/**)",
      "Read(~/.op/**)",
      "Read(~/.terraformrc)",
      "Read(~/.terraform.d/credentials.tfrc.json)",
      "Read(~/.config/heroku/**)",
      "Read(~/.npm/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=/home/jonathan/.claude/token-optimizer/.security-alert; [ -f \"$f\" ] && echo \"[token-optimizer] SECURITY ALERT: $(cat $f)\" || true"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"/home/jonathan/.claude/hooks/caveman-activate.js\"",
            "timeout": 5,
            "statusMessage": "Loading caveman mode..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "(CLV2_PYTHON_CMD=/usr/bin/python3 ECC_OBSERVER_TIMEOUT_SECONDS=300 ~/.claude/skills/continuous-learning-v2/agents/start-observer.sh start >/dev/null 2>&1 &) || true",
            "timeout": 3,
            "statusMessage": "Launching instinct observer..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/opus-warn.sh"
          },
          {
            "type": "command",
            "command": "python3 $HOME/.claude/context-baggage.py"
          },
          {
            "type": "command",
            "command": "python3 $HOME/.claude/date-reminder-hook.py"
          },
          {
            "type": "command",
            "command": "python3 $HOME/.claude/wellbeing/work-hours-nudge.py"
          },
          {
            "type": "command",
            "command": "python3 $HOME/.claude/wellbeing/habit-nudge.py"
          },
          {
            "type": "command",
            "command": "python3 $HOME/.claude/wellbeing/sunset-walk-nudge.py"
          },
          {
            "type": "command",
            "command": "python3 $HOME/.claude/step-back-nudge.py"
          },
          {
            "type": "command",
            "command": "python3 $HOME/.claude/evolve-reminder.py"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/home/jonathan/.claude/hooks/router-nudge-hook --queue-root /home/jonathan/.local/state/router/queue --marker /home/jonathan/.local/state/router/audit/nudge-marker || true"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"/home/jonathan/.claude/hooks/caveman-mode-tracker.js\"",
            "timeout": 5,
            "statusMessage": "Tracking caveman mode..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__tavily-remote-mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/wrap-untrusted-tavily.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/wrap-untrusted-bash.py"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/skills/continuous-learning-v2/hooks/observe.sh post"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/step-back-detector.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/jonathan/.local/bin/dcg"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/skills/continuous-learning-v2/hooks/observe.sh pre"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node '/home/jonathan/Repos/token-optimizer/skills/token-optimizer/scripts/statusline.js'"
  },
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "ask-questions-if-underspecified@trailofbits": true,
    "insecure-defaults@trailofbits": true,
    "sharp-edges@trailofbits": true,
    "superpowers@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "nix-search@nix-search-marketplace": true,
    "nixos@kettleofskills": true,
    "recursive-self-improvement@jonathanmoregard": true,
    "differential-review@trailofbits": true,
    "mutation-testing@trailofbits": true,
    "static-analysis@trailofbits": true,
    "debug-buttercup@trailofbits": true,
    "spec-to-code-compliance@trailofbits": true,
    "entry-point-analyzer@trailofbits": true,
    "caveman@caveman": true,
    "token-optimizer@alexgreensh-token-optimizer": true
  },
  "extraKnownMarketplaces": {
