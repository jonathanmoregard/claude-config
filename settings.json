{
  "permissions": {
    "allow": [
      "Bash",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "TodoWrite",
      "TodoRead",
      "Bash(~/.claude/date-reset.sh)",
      "mcp__android__*"
    ],
    "deny": [
      "Edit(~/.bashrc)",
      "Edit(~/.zshrc)",
      "Edit(~/.ssh/**)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.git-credentials)",
      "Read(~/.docker/config.json)",
      "Read(~/.kube/**)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.gem/credentials)",
      "Read(~/.config/todo/env)",
      "Read(~/Dropbox/1. Exocortex/**)",
      "Edit(~/Dropbox/1. Exocortex/**)",
      "Write(~/Dropbox/1. Exocortex/**)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/opus-warn.sh"
          },
          {
            "type": "command",
            "command": "python3 $HOME/.claude/context-baggage.py"
          },
          {
            "type": "command",
            "command": "python3 $HOME/.claude/date-reminder-hook.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/jonathan/.local/bin/dcg"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/no-tell-run.py"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "npx -y @owloops/claude-powerline@latest --style=powerline"
  },
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "ask-questions-if-underspecified@trailofbits": true,
    "insecure-defaults@trailofbits": true,
    "sharp-edges@trailofbits": true,
    "superpowers@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true
  },
  "voiceEnabled": true
}
