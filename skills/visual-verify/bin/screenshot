#!/usr/bin/env -S uv run --script
# visual-verify screenshot wrapper.
# Shebang uses `uv run --script` so PEP-723 deps below auto-install on first run.
# Fallback: any python3 works, but PyYAML + playwright must be provided by env.
#
# DPR=2, boundary widths, fresh browser context per state, document.fonts.ready,
# readiness selectors (not networkidle). Batch mode builds an index.html contact
# sheet. Exits non-zero on HTTP errors / unresolved auth walls so callers see it.
#
# Requires: playwright installed (pip / uv / nix devshell).
# PEP-723 inline deps — run with `uv run` for zero-install:
#
# /// script
# requires-python = ">=3.10"
# dependencies = ["playwright>=1.47", "PyYAML>=6"]
# ///

import argparse
import asyncio
import json
import os
import pathlib
import re
import sys
from typing import Optional
from urllib.parse import urlparse

try:
    import yaml  # type: ignore
except ModuleNotFoundError:  # keep working without PyYAML — just no config discovery
    yaml = None  # type: ignore


def _find_project_config(start: pathlib.Path) -> Optional[pathlib.Path]:
    """Walk up from start looking for .claude/visual-verify.yml."""
    cur = start.resolve()
    for _ in range(20):
        candidate = cur / ".claude" / "visual-verify.yml"
        if candidate.is_file():
            return candidate
        if cur.parent == cur:
            return None
        cur = cur.parent
    return None


def _load_project_config(explicit: Optional[str]) -> tuple[dict, Optional[pathlib.Path]]:
    """Return (config_dict, found_path). found_path=None means no file existed."""
    path = pathlib.Path(explicit) if explicit else _find_project_config(pathlib.Path.cwd())
    if not path or not path.is_file():
        return {}, None
    if yaml is None:
        sys.stderr.write(
            f"[visual-verify] FOUND {path} but PyYAML is not importable — cannot parse.\n"
            "  Either: (a) `pip install PyYAML` (or use the project's python env), or\n"
            "  (b) invoke this script via `uv run` — the PEP-723 header at the top of\n"
            "      bin/screenshot declares PyYAML as a dependency and uv fetches it.\n"
            "  Continuing without config; results will use CLI-flag defaults only.\n"
        )
        return {}, path
    try:
        data = yaml.safe_load(path.read_text(encoding="utf-8")) or {}
        sys.stderr.write(f"[visual-verify] loaded project config: {path}\n")
        return data, path
    except Exception as e:
        sys.stderr.write(f"[visual-verify] config parse failed at {path}: {e}\n")
        return {}, path


def _config_defaults(cfg: dict) -> dict:
    """Extract CLI defaults from the project config."""
    app = cfg.get("app") or {}
    dev_auth = cfg.get("dev_auth") or {}
    shots = cfg.get("screenshots") or {}
    token_env = dev_auth.get("token_env")
    token_val = os.environ.get(token_env) if token_env else None
    return {
        "base_url": app.get("base_url"),
        "ready": app.get("ready_selector"),
        "out_dir": shots.get("out_dir"),
        "dev_auth_header_name": dev_auth.get("header"),
        "dev_auth_cookie": dev_auth.get("cookie"),
        "dev_auth_token": token_val,
    }

DEFAULT_WIDTHS = [390, 767, 768, 1280]  # boundary widths, not representatives


# Script that runs in-page to dump the box model + role + name + label of every
# interactive/landmark/heading element in view. Feeds the DOM-observability
# emission that grounds VLM critiques in real geometry (not hallucinated pixels).
_DOM_DUMP_JS = r"""
(sel) => {
  const root = sel ? document.querySelector(sel) : document.body;
  if (!root) return { error: 'no root for selector', selector: sel };
  // Elements a design critic cares about: landmarks, headings, controls,
  // links, images, semantic containers. Skip pure text nodes / decorative divs.
  const q = 'main, nav, header, footer, aside, section, article, ' +
            'h1, h2, h3, h4, h5, h6, ' +
            'a, button, input, select, textarea, label, fieldset, legend, ' +
            'dialog, [role], [aria-label], img, svg';
  const nodes = Array.from(root.matches(q) ? [root, ...root.querySelectorAll(q)] : root.querySelectorAll(q));
  return nodes.map((el) => {
    const r = el.getBoundingClientRect();
    // Skip 0-size / offscreen (still counted at 0-width; caller can filter).
    const rect = { x: Math.round(r.x), y: Math.round(r.y), w: Math.round(r.width), h: Math.round(r.height) };
    const cs = window.getComputedStyle(el);
    const label = (el.getAttribute('aria-label') || el.getAttribute('title') ||
                   (el.tagName === 'IMG' ? el.getAttribute('alt') : null) ||
                   (el.tagName === 'INPUT' ? el.getAttribute('placeholder') : null) ||
                   // Array.from() splits by Unicode codepoint (astral pairs stay
                   // whole). .slice() on the resulting array cannot produce a
                   // lone UTF-16 surrogate at the boundary — otherwise the JSON
                   // downstream fails utf-8 encode with `surrogates not allowed`
                   // (both advisors flagged this; codex reproduced 2026-08-01).
                   Array.from((el.innerText || '').trim()).slice(0, 80).join('') || null);
    return {
      tag: el.tagName.toLowerCase(),
      role: el.getAttribute('role') || null,
      id: el.id || null,
      class: (el.getAttribute('class') || '').trim() || null,
      rect,
      font: `${cs.fontWeight} ${cs.fontSize}/${cs.lineHeight} ${cs.fontFamily.split(',')[0].replace(/["']/g,'')}`,
      color: cs.color,
      bg: cs.backgroundColor,
      pad: `${cs.paddingTop} ${cs.paddingRight} ${cs.paddingBottom} ${cs.paddingLeft}`,
      border: cs.borderTopWidth === '0px' && cs.borderRightWidth === '0px' &&
              cs.borderBottomWidth === '0px' && cs.borderLeftWidth === '0px'
              ? null : `${cs.borderTopWidth} ${cs.borderRightWidth} ${cs.borderBottomWidth} ${cs.borderLeftWidth} · ${cs.borderTopColor}`,
      label,
    };
  }).filter((n) => n.rect.w > 0 && n.rect.h > 0);
}
"""


async def _capture_one(
    browser,
    url: str,
    width: int,
    height: int,
    selector: Optional[str],
    ready_selector: str,
    out_path: pathlib.Path,
    dev_auth_token: Optional[str],
    dev_auth_header_name: str,
    dev_auth_cookie: Optional[str],
    emit_aria: bool,
    emit_dom: bool,
) -> tuple[int, dict]:
    """Return (HTTP status, artifact_paths). status 0 = ok, non-zero = http error / auth wall."""
    ctx = await browser.new_context(
        viewport={"width": width, "height": height},
        device_scale_factor=2,
    )
    try:
        return await _capture_body(
            ctx, url, selector, ready_selector, out_path,
            dev_auth_token, dev_auth_header_name, dev_auth_cookie,
            emit_aria, emit_dom,
        )
    finally:
        # R3 fix ([both] HIGH): context MUST close even on exception, else
        # per-width leaks accumulate until browser tear-down.
        await ctx.close()


async def _capture_body(
    ctx,
    url: str,
    selector: Optional[str],
    ready_selector: str,
    out_path: pathlib.Path,
    dev_auth_token: Optional[str],
    dev_auth_header_name: str,
    dev_auth_cookie: Optional[str],
    emit_aria: bool,
    emit_dom: bool,
) -> tuple[int, dict]:
    """Actual capture logic; caller owns ctx lifecycle."""
    if dev_auth_cookie:
        # Cookie form: `name=value` or `name=value; domain=host`. When no
        # `domain=` part, use the target URL — Playwright requires either
        # `url` or `domain` (advisor caught: `domain=None` crashes add_cookies).
        cookie_str, _, domain_part = dev_auth_cookie.partition(";")
        name, _, value = cookie_str.partition("=")
        domain = None
        dp = domain_part.strip()
        if dp.startswith("domain="):
            domain = dp.removeprefix("domain=").strip() or None
        cookie: dict = {"name": name.strip(), "value": value.strip(), "path": "/"}
        if domain:
            cookie["domain"] = domain
        else:
            cookie["url"] = url
        await ctx.add_cookies([cookie])
    page = await ctx.new_page()
    if dev_auth_token:
        await page.set_extra_http_headers({dev_auth_header_name: dev_auth_token})
    resp = await page.goto(url, wait_until="domcontentloaded")
    status = resp.status if resp else 0
    if status >= 400:
        sys.stderr.write(f"[visual-verify] HTTP {status} for {url}\n")
    # Detect auth wall — check path AND fragment AND query for login-ish routes
    # (hash-router redirects `/#/login` and query-only `/?next=login` were both
    # advisor-flagged R3 as blind spots). R4 (Codex): switched from `(^|/)...
    # (/|$|=)` to word-boundary `\b...\b` — old regex missed `next=login` (login
    # preceded by `=`, not `/` or start). `\b` treats any word-boundary as
    # anchor, catches all query/fragment/path forms without false positives on
    # `/logout` or `/loginhistory` (verified locally).
    # `oauth\d*` catches `/oauth2/authorize` (R7 Codex catch); `sign[-_]?in`
    # catches `/sign-in` and `/sign_in` variants (R8 Codex catch); `\b`
    # boundary still safely skips `/logout` etc.
    auth_paths_re = re.compile(r"\b(login|sign[-_]?in|oauth\d*|magic)\b")
    _pu = urlparse(page.url)
    for source in (_pu.path, _pu.fragment, _pu.query):
        if source and auth_paths_re.search(source):
            sys.stderr.write(f"[visual-verify] auth wall — landed on {page.url}\n")
            status = 401
            break
    # Readiness — replace 'main' with your app's ready selector for accuracy.
    # R3 sentinel: if the ready selector never appears, mark ready_failed so the
    # caller sees `[ready!]` and --strict-artifacts exits non-zero (was silent).
    ready_failed: Optional[str] = None
    try:
        await page.wait_for_selector(ready_selector, state="visible", timeout=8000)
    except Exception as e:
        sys.stderr.write(f"[visual-verify] readiness wait failed: {e}\n")
        ready_failed = str(e)
    await page.evaluate("document.fonts.ready")

    artifacts = {}
    if ready_failed:
        artifacts["ready_failed"] = ready_failed
    # Short selector timeout — advisor flagged 30s default hang on bad selectors
    # (multiplied by widths = minutes of silent wait).
    SEL_TIMEOUT_MS = 2000

    if selector:
        try:
            el = page.locator(selector).first
            # R6: count() short-circuit before screenshot — Playwright's
            # actionability wait ignores the `timeout` kwarg on missing
            # elements (waits full 30s regardless). Same fix R1 applied to
            # aria_snapshot. Discovered when repro of R5's shot_failed took
            # 30s per width instead of 2s.
            if await el.count() == 0:
                raise RuntimeError(f"selector {selector!r} matches nothing")
            await el.screenshot(path=str(out_path), timeout=SEL_TIMEOUT_MS)
        except Exception as e:
            sys.stderr.write(f"[visual-verify] selector capture failed: {e} — falling back to full-page (marked [shot!])\n")
            # R3 sentinel: silent fallback to full-page misled callers into
            # thinking the intended selector rendered. Mark shot_failed so the
            # PNG filename doesn't lie about what's inside.
            artifacts["shot_failed"] = str(e)
            await page.screenshot(path=str(out_path), full_page=True)
    else:
        await page.screenshot(path=str(out_path), full_page=True)

    # ARIA snapshot — accessibility tree, the primary agent-readable signal per
    # 2026 SOTA (Playwright first-party). Text-YAML from Playwright's own dump.
    if emit_aria:
        try:
            if selector:
                target = page.locator(selector).first
                if await target.count() == 0:
                    raise RuntimeError(f"selector {selector!r} matches nothing — skip aria")
            else:
                target = page.locator("body")
            aria = await target.aria_snapshot(timeout=SEL_TIMEOUT_MS)
            aria_path = out_path.with_suffix(".aria.yaml")
            aria_path.write_text(aria, encoding="utf-8", errors="replace")
            artifacts["aria"] = aria_path.name
        except Exception as e:
            sys.stderr.write(f"[visual-verify] aria snapshot failed: {e}\n")
            # Sentinel — CLI prints [aria!] so silent failure isn't invisible
            artifacts["aria_failed"] = str(e)

    # DOM box-model dump — grounds VLM critiques in real geometry (spacing,
    # alignment, contrast, hierarchy). Suppresses hallucinated findings that
    # advisor research flagged as a critic failure mode (docs/reviews/sota-
    # ai-power-users-cohort-2026-07-30.md).
    if emit_dom:
        try:
            dom = await page.evaluate(_DOM_DUMP_JS, selector or None)
            # Selector-scoped dump returns {error, selector} when root is
            # missing — both advisors ([opus]+[gpt5.5]) flagged as response-shape
            # inconsistency (downstream critics expect a list). Promote to failure.
            if isinstance(dom, dict) and "error" in dom:
                raise RuntimeError(f"dom root not found: {dom.get('error')} (selector={dom.get('selector')!r})")
            dom_path = out_path.with_suffix(".dom.json")
            # errors='replace' is a safety net; the JS side already uses
            # Array.from().slice().join() to avoid mid-surrogate truncation,
            # but any lone surrogate that slips through gets replaced with '?'
            # instead of crashing utf-8 encode (both advisors flagged this).
            dom_path.write_text(
                json.dumps(dom, indent=2, ensure_ascii=False),
                encoding="utf-8",
                errors="replace",
            )
            artifacts["dom"] = dom_path.name
        except Exception as e:
            sys.stderr.write(f"[visual-verify] dom dump failed: {e}\n")
            artifacts["dom_failed"] = str(e)

    return status, artifacts


async def run(args):
    cfg, cfg_path = _load_project_config(args.config)
    defaults = _config_defaults(cfg)

    url = args.url or defaults.get("base_url")
    if not url:
        if cfg_path is None:
            sys.stderr.write(
                "[visual-verify] no project config found (.claude/visual-verify.yml) and no URL passed.\n"
                "  Two options:\n"
                "  1) pass a URL: `bin/screenshot http://localhost:PORT`\n"
                "  2) generate a project config — follow the 'Setup' section in\n"
                "     ~/.claude/skills/visual-verify/SKILL.md (9 steps, all discoverable\n"
                "     from the repo). Then re-run.\n"
            )
        elif not cfg:
            sys.stderr.write(
                f"[visual-verify] project config at {cfg_path} could not be parsed (see warning above).\n"
                "  Fix parseability (install PyYAML or use `uv run`), or pass a URL directly.\n"
            )
        else:
            sys.stderr.write(
                f"[visual-verify] project config {cfg_path} loaded but no app.base_url set — either\n"
                "  add it there, or pass a URL on the command line.\n"
            )
        return 2

    out_dir = pathlib.Path(args.out or defaults.get("out_dir") or "/tmp/visual-verify").expanduser().resolve()
    out_dir.mkdir(parents=True, exist_ok=True)

    ready = args.ready or defaults.get("ready") or "main"
    dev_auth_token = args.dev_auth_token or defaults.get("dev_auth_token")
    dev_auth_header_name = defaults.get("dev_auth_header_name") or "X-Dev-Auth"
    dev_auth_cookie = args.dev_auth_cookie or defaults.get("dev_auth_cookie")

    widths = args.widths or DEFAULT_WIDTHS
    shots: list[dict] = []
    exit_code = 0

    try:
        from playwright.async_api import async_playwright  # late import
    except ModuleNotFoundError:
        sys.stderr.write(
            "[visual-verify] playwright not importable. Install: `pip install playwright && playwright install chromium`\n"
            "  Or run this script via `uv run` — PEP-723 header will fetch deps automatically.\n"
        )
        return 3

    async with async_playwright() as p:
        browser = await p.chromium.launch()
        for width in widths:
            # R3 fix (Codex HIGH): selectors like `a[href="/login"]` had quotes
            # and slashes that became a bogus nested path. Aggressive sanitize.
            safe_sel = re.sub(r"[^\w-]", "_", args.selector or "fullpage").strip("_") or "fullpage"
            filename = f"{safe_sel}-{width}.png"
            out_path = out_dir / filename
            status, artifacts = await _capture_one(
                browser,
                url=url,
                width=width,
                height=args.height,
                selector=args.selector or None,
                ready_selector=ready,
                out_path=out_path,
                dev_auth_token=dev_auth_token,
                dev_auth_header_name=dev_auth_header_name,
                dev_auth_cookie=dev_auth_cookie,
                emit_aria=not args.no_aria,
                emit_dom=not args.no_dom,
            )
            shots.append({
                "url": url, "width": width, "path": filename, "status": status,
                "aria": artifacts.get("aria"), "dom": artifacts.get("dom"),
                "aria_failed": artifacts.get("aria_failed"),
                "dom_failed": artifacts.get("dom_failed"),
                "ready_failed": artifacts.get("ready_failed"),
                "shot_failed": artifacts.get("shot_failed"),
            })
            # R5 (Codex HIGH): ready_failed + shot_failed ALWAYS exit non-zero
            # (agents / CI must see them). ARIA/DOM stay opt-in via --strict.
            if artifacts.get("ready_failed") or artifacts.get("shot_failed"):
                exit_code = 1
            if args.strict_artifacts and (
                artifacts.get("aria_failed") or artifacts.get("dom_failed")
            ):
                exit_code = 1
            if status and status >= 400:
                exit_code = 1
        await browser.close()

    # Contact sheet
    if not args.no_index and shots:
        _write_index(out_dir, shots)
        print(f"contact sheet: file://{out_dir}/index.html")

    for s in shots:
        parts = []
        if s.get("ready_failed"):
            parts.append("[ready!]")
        if s.get("shot_failed"):
            parts.append("[shot!]")
        for k in ("aria", "dom"):
            if s.get(k):
                parts.append(f"[{k}]")
            elif s.get(f"{k}_failed"):
                parts.append(f"[{k}!]")  # visible failure marker
        extras = " ".join(parts)
        print(f"  {s['width']:>4}w  status={s['status']:>3}  {s['path']} {extras}".rstrip())
    return exit_code


def _write_index(out_dir: pathlib.Path, shots: list[dict]) -> None:
    def _links(s):
        parts = []
        if s.get("ready_failed"):
            parts.append('<span style="color:#f77">ready!</span>')
        if s.get("shot_failed"):
            parts.append('<span style="color:#f77">shot!</span>')
        if s.get("aria"):
            parts.append(f'<a href="{s["aria"]}">aria.yaml</a>')
        elif s.get("aria_failed"):
            parts.append('<span style="color:#f77">aria!</span>')
        if s.get("dom"):
            parts.append(f'<a href="{s["dom"]}">dom.json</a>')
        elif s.get("dom_failed"):
            parts.append('<span style="color:#f77">dom!</span>')
        return " · ".join(parts)
    rows = "\n".join(
        f"""<div class="cell">
    <div class="meta">{s['width']}w · status {s['status']}{('  ·  ' + _links(s)) if _links(s) else ''}</div>
    <a href="{s['path']}"><img src="{s['path']}" loading="lazy"></a>
  </div>"""
        for s in shots
    )
    html = f"""<!doctype html>
<meta charset=utf-8>
<title>visual-verify contact sheet</title>
<style>
  body {{ font: 13px/1.4 -apple-system,BlinkMacSystemFont,sans-serif; margin: 12px; background: #111; color: #ddd; }}
  h1 {{ font-size: 15px; margin: 0 0 12px; }}
  .grid {{ display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 12px; }}
  .cell {{ background: #1a1a1a; padding: 8px; border-radius: 6px; }}
  .cell img {{ width: 100%; height: auto; display: block; border-radius: 4px; }}
  .meta {{ margin-bottom: 6px; color: #888; }}
</style>
<h1>visual-verify · {len(shots)} shots</h1>
<div class="grid">
{rows}
</div>
"""
    (out_dir / "index.html").write_text(html, encoding="utf-8")


def main() -> int:
    ap = argparse.ArgumentParser(
        description="Capture screenshot(s) at boundary widths with DPR=2, fonts ready, no networkidle. "
                    "Reads .claude/visual-verify.yml from cwd or any ancestor for project defaults."
    )
    ap.add_argument("url", nargs="?", default=None,
                    help="URL to capture. If omitted, reads app.base_url from project config.")
    ap.add_argument("--selector", default="", help="CSS selector for element shot (else full page)")
    ap.add_argument("--widths", type=int, nargs="*", help=f"Widths in px. Default: {DEFAULT_WIDTHS}")
    ap.add_argument("--height", type=int, default=844, help="Viewport height (default 844)")
    ap.add_argument("--ready", default=None,
                    help="Readiness selector. Overrides project config (default: main).")
    ap.add_argument("--out", default=None,
                    help="Output dir. Overrides project config (default: /tmp/visual-verify).")
    ap.add_argument("--dev-auth-token", default=None,
                    help="Auth-bypass token value. Overrides project config's env-var lookup.")
    ap.add_argument("--dev-auth-cookie", default=None,
                    help="'name=value; domain=host' cookie for dev auth.")
    ap.add_argument("--config", default=None,
                    help="Explicit path to visual-verify.yml (else discover .claude/visual-verify.yml).")
    ap.add_argument("--no-index", action="store_true", help="Skip contact-sheet HTML")
    ap.add_argument("--no-aria", action="store_true",
                    help="Skip ARIA snapshot (default: emit <shot>.aria.yaml)")
    ap.add_argument("--no-dom", action="store_true",
                    help="Skip DOM box-model dump (default: emit <shot>.dom.json)")
    ap.add_argument("--strict-artifacts", action="store_true",
                    help="Also exit non-zero on aria/dom failures. "
                         "ready/shot failures ALWAYS exit non-zero regardless of this flag.")
    args = ap.parse_args()
    return asyncio.run(run(args))


if __name__ == "__main__":
    sys.exit(main())
