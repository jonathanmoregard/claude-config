{
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Bash(git*)",
      "Read({{REPO}}/**)",
      "Edit({{REPO}}/**)",
      "Write({{REPO}}/**)",
      "Write({{DATA_DIR}}/last-update.log)"
    ],
    "deny": [
      "WebFetch",
      "WebSearch",
      "Agent",
      "Task",
      "Skill",
      "NotebookEdit",
      "Glob",
      "Grep"
    ]
  },
  "env": {
    "CLAUDE_CODE_DISABLE_BACKGROUND_TASKS": "1",
    "CLAUDE_CODE_DISABLE_CLAUDE_MDS": "1",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "BASH_DEFAULT_TIMEOUT_MS": "60000",
    "BASH_MAX_TIMEOUT_MS": "180000"
  }
}
