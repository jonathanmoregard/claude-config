#!/usr/bin/env python3
"""A stand-in for nixos-config's `secret-redact`, for tests a CI runner runs.

Same contract (stdin {"texts", "timeout"}, stdout {"texts", "counts"}, exit 1
on any fault), but it finds one shape only: `sk-ant-` tokens, anchored the way
the pinned rules are (`(?:^|[^a-zA-Z0-9+/_-])`), so a token right after a
letter -- the `n` of a JSON `\\n` escape -- is missed here as it is there.
A text holding FAIL-THE-SCAN makes it exit 1, the way a broken scanner does.
"""
import json
import re
import sys

TOKEN = re.compile(r"(?:^|(?<=[^a-zA-Z0-9+/_-]))sk-ant-[A-Za-z0-9_-]{8,}")

request = json.load(sys.stdin)
texts = request["texts"]
if any("FAIL-THE-SCAN" in t for t in texts):
    print("secret-redact (fake): scan failed", file=sys.stderr)
    sys.exit(1)
out, counts = [], []
for text in texts:
    n = len(TOKEN.findall(text))
    out.append(TOKEN.sub(lambda m: f"[REDACTED:anthropic-token:{len(m.group(0))}chars]", text))
    counts.append({"anthropic-token": n} if n else {})
json.dump({"texts": out, "counts": counts}, sys.stdout)
