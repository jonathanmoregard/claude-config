  "model": "opus[1m]",
  "autoCompactWindow": 420000,
  "enableAllProjectMcpServers": false,
  "hooks": {
    "PermissionDenied": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S -E $HOME/.claude/permission-ledger/hook.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S -E $HOME/.claude/permission-ledger/hook.py",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"${CLAUDE_CODE_ENTRYPOINT:-cli}\" = \"cli\" ] || exit 0; command -v agent-activity >/dev/null || exit 0; agent-activity mark PermissionRequest",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(Bash|mcp__github__create_pull_request)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S -E $HOME/.claude/hooks/pr-open-gate.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S -E $HOME/.claude/hooks/native-agent-route-observer.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 -S -E $HOME/.claude/hooks/agent-idle-alarm.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/visual-verify-trigger.sh"
          },
          {
            "type": "command",
            "command": "python3 -S -E $HOME/.claude/hooks/grader-regex-lint.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S -E $HOME/.claude/hooks/bash-output-guard.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f $HOME/.claude/hooks/sandbox-aid.py ] || exit 0; python3 -S -E $HOME/.claude/hooks/sandbox-aid.py",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S -E $HOME/.claude/hooks/tool-output-redact.py",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"${CLAUDE_CODE_ENTRYPOINT:-cli}\" = \"cli\" ] || exit 0; command -v agent-activity >/dev/null || exit 0; agent-activity mark PostToolUse",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(Agent|Read|SendMessage|mcp__artl_verdict__submit_verdict)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S -E $HOME/.claude/hooks/artl-evidence.py",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f $HOME/.claude/hooks/sandbox-aid.py ] || exit 0; python3 -S -E $HOME/.claude/hooks/sandbox-aid.py",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/skills/session-reflect/reflect.sh precompact"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^AskUserQuestion$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S -E $HOME/.claude/hooks/night-proceed.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"${CLAUDE_CODE_ENTRYPOINT:-cli}\" = \"cli\" ] || exit 0; $HOME/.claude/hooks/git-push-merge-check.sh",
            "timeout": 12
          }
        ]
      },
      {
        "matcher": "^(Bash|Monitor)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/hooks/bash-guard.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S -E $HOME/.claude/hooks/deny-hints.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f $HOME/.claude/hooks/sandbox-aid.py ] || exit 0; python3 -S -E $HOME/.claude/hooks/sandbox-aid.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^(Write|Edit|MultiEdit|NotebookEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S -E $HOME/.claude/hooks/path-edit-guard.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(Write|Edit|MultiEdit|NotebookEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S -E $HOME/.claude/hooks/redaction-marker-write-guard.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Grep|Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $HOME/.claude/aggregator-transcript-guard.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^(Bash|mcp__github__create_pull_request)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -S -E $HOME/.claude/hooks/pr-open-gate.py",
            "timeout": 10
          }
        ]
      }
    ],
