#!/usr/bin/env -S python3 -I
"""confined -- <command> [args...]
confined --detach <slug> -- <command> [args...]

Run a command outside the Claude Code sandbox, in a bubblewrap jail of its own
that hides and protects what the `sandbox` block of the settings.json beside
this config hides and protects, but leaves user namespaces enabled so nested
bwrap works. Network is NOT restricted: bwrap cannot filter by domain.

--detach starts the jailed command as the user unit <slug>.service, logging to
/tmp/<slug>.log, the way `wait-for job` does, so `wait-for unit <slug>.service
--user` (or `wait-for job <slug> -- ...`) observes it.

Exit: the command's status · 3 cannot build the jail · 64 usage or refusal.
"""
from __future__ import annotations

import glob
import json
import os
import pwd
import re
import subprocess
import sys
from pathlib import Path

SLUG = re.compile(r"^[a-z0-9][a-z0-9-]{0,40}$")
GLOB_CHARS = re.compile(r"[*?\[]")
JOB_WRAPPER = """
log=$1; shift
"$@" >"$log" 2>&1; rc=$?
if [ "$rc" = 0 ]; then echo MARKER_OK >>"$log"; else echo "MARKER_FAILED rc=$rc" >>"$log"; fi
exit "$rc"
"""


def fail(code: int, message: str) -> None:
    print(f"confined: {message}", file=sys.stderr)
    sys.exit(code)


def usage() -> None:
    print(__doc__.split("\n\n", 1)[0], file=sys.stderr)
    sys.exit(64)


def parse(argv: list[str]) -> tuple[str | None, list[str]]:
    slug = None
    if argv[:1] == ["--detach"]:
        if len(argv) < 2 or not SLUG.fullmatch(argv[1]):
            usage()
        if argv[1].startswith("claude-"):
            fail(64, "slugs beginning with claude- are reserved")
        slug, argv = argv[1], argv[2:]
    if argv[:1] != ["--"] or len(argv) < 2:
        usage()
    return slug, argv[1:]


def find(name: str, user: str) -> str | None:
    # A fixed search, not PATH: this runs outside the sandbox without a prompt.
    for directory in ("/run/current-system/sw/bin", f"/etc/profiles/per-user/{user}/bin",
                      "/usr/bin", "/bin"):
        candidate = os.path.join(directory, name)
        if os.access(candidate, os.X_OK):
            return candidate
    return None


def under(path: str, root: str) -> bool:
    return path == root or path.startswith(root.rstrip("/") + "/")


def expand(home: str, entry: str) -> str | None:
    if entry.startswith("~/"):
        return os.path.join(home, entry[2:])
    return entry if entry.startswith("/") else None


def existing(paths: list[str], expand_globs: bool = False) -> list[str]:
    out = []
    for path in paths:
        matches = glob.glob(path) if expand_globs and GLOB_CHARS.search(path) else [path]
        out += [os.path.realpath(m) for m in matches if os.path.exists(m)]
    return out


class Profile:
    def __init__(self, settings_path: Path, home: str) -> None:
        try:
            settings = json.loads(settings_path.read_text(encoding="utf-8"))
            sandbox = settings["sandbox"]
            fs = sandbox.get("filesystem", {})
            creds = sandbox.get("credentials", {})
            def paths(entries: list[str]) -> list[str]:
                return [p for p in (expand(home, e) for e in entries) if p]

            self.allow = existing(paths(fs.get("allowWrite", []))) + ["/tmp"]
            self.deny_write = existing(paths(fs.get("denyWrite", [])))
            blocked = existing(paths(fs.get("denyRead", [])), expand_globs=True)
            blocked += existing(paths([c["path"] for c in creds.get("files", [])]))
            hide = blocked + existing(paths(["~/.ssh", "~/.codex/auth.json"]))
            hide += existing(self.read_rules(settings, home, settings_path.parent))
            self.deny_env = sorted({v["name"] for v in creds.get("envVars", [])
                                    if v.get("mode") == "deny"})
        except (OSError, ValueError, KeyError, TypeError, AttributeError) as e:
            fail(3, f"cannot read the sandbox profile from {settings_path}: {e!r}")
        self.hide = self.outermost(hide)
        # Claude's sandbox leaves this readable despite its Read rule; agent e2e
        # needs it, writable for token refresh. The sandbox block still wins.
        claude_creds = os.path.realpath(os.path.join(home, ".claude/.credentials.json"))
        self.refresh = []
        covering = blocked + [h for h in self.hide if h != claude_creds]
        if os.path.isfile(claude_creds) and not any(under(claude_creds, h) for h in covering):
            self.hide = [h for h in self.hide if h != claude_creds]
            self.refresh = [claude_creds]

    @staticmethod
    def read_rules(settings: dict, home: str, config_dir: Path) -> list[str]:
        paths = []
        for rule in settings.get("permissions", {}).get("deny", []):
            match = re.fullmatch(r"Read\((.+)\)", rule)
            if not match:
                continue
            spec = match.group(1).removesuffix("/**")
            if GLOB_CHARS.search(spec):
                continue
            if spec.startswith("//"):
                paths.append(spec[1:])
            elif spec.startswith("~/"):
                paths.append(os.path.join(home, spec[2:]))
            elif spec.startswith("/"):
                paths.append(str(config_dir / spec[1:]))
        return paths

    @staticmethod
    def outermost(paths: list[str]) -> list[str]:
        # bwrap cannot create a mount point inside an already hidden directory.
        kept: list[str] = []
        for path in sorted(set(paths)):
            if not any(under(path, k) for k in kept if os.path.isdir(k)):
                kept.append(path)
        return kept

    def writable(self, path: str) -> bool:
        return (any(under(path, r) for r in self.allow)
                and not any(under(path, d) for d in self.deny_write))

    def bwrap_args(self, cwd: str, foreground: bool) -> list[str]:
        args = ["--ro-bind", "/", "/", "--dev", "/dev", "--proc", "/proc",
                "--unshare-pid", "--unshare-ipc", "--new-session"]
        if foreground:
            args.append("--die-with-parent")
        for root in self.allow + self.refresh:
            args += ["--bind", root, root]
        for path in self.deny_write:
            args += ["--ro-bind", path, path]
        for path in self.hide:
            if os.path.isdir(path):
                args += ["--tmpfs", path, "--remount-ro", path]
            else:
                # --ro-bind would mount it nodev: reads fail EACCES instead of empty.
                args += ["--dev-bind", "/dev/null", path]
        for name in self.deny_env:
            args += ["--unsetenv", name]
        return args + ["--setenv", "SANDBOX_RUNTIME", "1", "--chdir", cwd]


def detach(slug: str, jail: list[str], command: list[str], cwd: str, user: str,
           here: Path) -> None:
    systemd_run, bash = find("systemd-run", user), find("bash", user)
    recorder = here / "record-user-unit-failure"
    if not systemd_run or not bash or not os.access(recorder, os.X_OK):
        fail(3, "systemd-run, bash or record-user-unit-failure is missing")
    log = f"/tmp/{slug}.log"
    runtime = f"/run/user/{os.getuid()}"
    # The log is written inside the jail: a link planted at that /tmp path must
    # not get an unconfined writer.
    proc = subprocess.run(
        [systemd_run, "--user", "--quiet", f"--unit={slug}", f"--working-directory={cwd}",
         "-p", "RemainAfterExit=yes", "-p", f"ExecStopPost={recorder} {slug} {log}",
         "--", *jail, "--", bash, "-c", JOB_WRAPPER, "confined-job", log, *command],
        env={"XDG_RUNTIME_DIR": runtime, "DBUS_SESSION_BUS_ADDRESS": f"unix:path={runtime}/bus"},
        stdin=subprocess.DEVNULL, capture_output=True, text=True, check=False)
    if proc.returncode != 0:
        fail(3, f"could not start {slug}.service: {proc.stderr.strip()}")
    print(f"confined: started {slug}.service log={log}")
    sys.exit(0)


def main() -> None:
    slug, command = parse(sys.argv[1:])
    entry = pwd.getpwuid(os.getuid())
    here = Path(__file__).resolve().parent
    profile = Profile(here.parent / "settings.json", entry.pw_dir)
    bwrap = find("bwrap", entry.pw_name)
    if not bwrap:
        fail(3, "bwrap not found")
    try:
        cwd = os.path.realpath(os.getcwd())
    except OSError as e:
        fail(64, f"cannot resolve the working directory: {e}")
    if not profile.writable(cwd):
        fail(64, f"{cwd} is not under a writable root of the sandbox profile")
    jail = [bwrap, *profile.bwrap_args(cwd, foreground=slug is None)]
    if slug:
        detach(slug, jail, command, cwd, entry.pw_name, here)
    os.execv(bwrap, [*jail, "--", *command])


if __name__ == "__main__":
    main()
