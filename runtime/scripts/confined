#!/run/current-system/sw/bin/python3 -I
"""confined [--chdir DIR] -- <command> [args...]
confined [--chdir DIR] --detach <slug> [--max-runtime 4h] -- <command> [args...]

Run a command outside the Claude Code sandbox, in a bubblewrap jail of its own
that leaves user namespaces enabled, so nested sandboxes work.

Writable: the repository around the working directory (a .git directory in it
too, but not its hooks and config; a git dir elsewhere, such as a linked
worktree's, is read-only, so commit outside the jail) and $TMPDIR, /tmp/confined-<uid>, shared between
jails. Home, /tmp, /run and /var are empty but for that repository, Claude's
credentials file and SHOWN. Agent and git config at the top of the repository
cannot be written or created; in its subdirectories, not written. A directory
holding other checkouts is refused, except under /tmp. What the `sandbox` block and Read deny rules of the
settings.json beside this config hide stays hidden.
Network: its own namespace, IPv4 only. The host, private, link-local and
tailnet ranges are refused, except DNS to the configured resolvers; the rest of
the internet is reachable, without a domain filter.

--detach runs it as the user unit <slug>.service, stopped after --max-runtime,
logging to $TMPDIR/<slug>.log. `wait-for unit <slug>.service --user` observes
it. A slug is single-use.

Exit: the command's status · 3 cannot build the jail · 64 usage or refusal.
"""
from __future__ import annotations

import ctypes
import fcntl
import glob
import json
import os
import pwd
import re
import signal
import stat
import subprocess
import sys
import time
from dataclasses import dataclass, field
from pathlib import Path

SLUG = re.compile(r"^[a-z0-9][a-z0-9-]{0,40}$")
SPAN = re.compile(r"^[1-9][0-9]*(s|min|h)$")
GLOB_CHARS = re.compile(r"[*?\[]")
# A fixed search, not PATH: this runs outside the sandbox without a prompt.
SEARCH = ("/run/current-system/sw/bin", "/etc/profiles/per-user/{user}/bin", "/usr/sbin",
          "/usr/bin", "/sbin", "/bin")
PASTA = ["--quiet", "--config-net", "--ipv4-only", "--no-map-gw", "-t", "none", "-u", "none",
         "-T", "none", "-U", "none"]
NON_GLOBAL = ("0.0.0.0/8", "10.0.0.0/8", "100.64.0.0/10", "127.0.0.0/8", "169.254.0.0/16",
              "172.16.0.0/12", "192.0.0.0/24", "192.0.2.0/24", "192.168.0.0/16", "198.18.0.0/15",
              "198.51.100.0/24", "203.0.113.0/24", "224.0.0.0/3")
# Home, /tmp, /run and /var start empty in the jail; these come back read-only.
# /run and /var hold host service sockets (tailscaled, libvirt, VM shares).
SHOWN = {"home": (".local/bin/claude", ".config/dcg/config.toml"), "/run": ("current-system",),
         "/var": ()}
PROTECTED = (
    ".claude/settings.json", ".claude/settings.local.json", ".claude/hooks", ".claude/skills",
    ".claude/agents", ".claude/commands", ".claude/workflows", ".claude/routines",
    ".claude/output-styles", ".claude/launch.json", ".claude/scheduled_tasks.json",
    ".claude/loop.md", ".mcp.json", ".gitconfig", ".gitmodules", ".bashrc", ".bash_profile",
    ".zshrc", ".zprofile", ".profile", ".ripgreprc", ".vscode", ".idea",
)
STUB_MARK = "user.confined-stub"
JOB_WRAPPER = """
log=$1; shift
"$@" >"$log" 2>&1; rc=$?
if [ "$rc" = 0 ]; then echo MARKER_OK >>"$log"; else echo "MARKER_FAILED rc=$rc" >>"$log"; fi
exit "$rc"
"""


def fail(code: int, message: str) -> None:
    print(f"confined: {message}", file=sys.stderr)
    sys.exit(code)


def usage() -> None:
    print(__doc__.split("\n\n", 1)[0], file=sys.stderr)
    sys.exit(64)


@dataclass
class Args:
    command: list[str] = field(default_factory=list)
    chdir: str | None = None
    slug: str | None = None
    max_runtime: str | None = None


def parse(argv: list[str]) -> Args:
    args = Args()
    while argv[:1] != ["--"]:
        if len(argv) < 2:
            usage()
        flag, value, argv = argv[0], argv[1], argv[2:]
        if flag == "--chdir" and args.chdir is None and value != "--":
            args.chdir = value
        elif flag == "--detach" and args.slug is None and SLUG.fullmatch(value):
            if value.startswith("claude-"):
                fail(64, "slugs beginning with claude- are reserved")
            args.slug = value
        elif flag == "--max-runtime" and args.max_runtime is None and SPAN.fullmatch(value):
            args.max_runtime = value
        else:
            usage()
    if len(argv) < 2 or (args.max_runtime and not args.slug):
        usage()
    args.command = argv[1:]
    return args


def find(name: str, user: str) -> str:
    for directory in SEARCH:
        candidate = os.path.join(directory.format(user=user), name)
        if os.access(candidate, os.X_OK):
            return candidate
    fail(3, f"{name} not found; refusing to run without the jail it builds")


def under(path: str, root: str) -> bool:
    return path == root or path.startswith(root.rstrip("/") + "/")


def absolute(home: str, entry: str, what: str) -> str:
    if entry.startswith("~/"):
        return os.path.join(home, entry[2:])
    if not entry.startswith("/"):
        fail(3, f"{what} entry {entry!r} is not an absolute path; refusing to guess its meaning")
    return entry


def existing(paths: list[str]) -> list[str]:
    return [os.path.realpath(p) for p in paths if os.path.exists(p)]


def literal_root(pattern: str) -> str:
    return os.path.dirname(GLOB_CHARS.split(pattern, 1)[0]) or "/"


def read_pointer(path: Path, prefix: str = "") -> str | None:
    try:
        with open(path, encoding="utf-8") as f:
            text = f.read(4096).strip()
    except (OSError, UnicodeDecodeError):
        return None
    return text[len(prefix):].strip() or None if text.startswith(prefix) else None


class Profile:
    """The `sandbox` block and Read deny rules of a settings.json."""

    def __init__(self, settings_path: Path, home: str) -> None:
        try:
            settings = json.loads(settings_path.read_text(encoding="utf-8"))
            sandbox = settings["sandbox"]
            fs = sandbox.get("filesystem", {})
            creds = sandbox.get("credentials", {})

            def paths(entries: list[str], what: str) -> list[str]:
                return [absolute(home, e, what) for e in entries]

            self.roots = existing(paths(fs.get("allowWrite", []), "allowWrite"))
            self.deny_write = existing(paths(fs.get("denyWrite", []), "denyWrite"))
            self.blocked = paths(fs.get("denyRead", []), "denyRead")
            self.blocked += paths([c["path"] for c in creds.get("files", [])], "credentials")
            self.rules = self.read_rules(settings, home, settings_path.parent)
            self.deny_env = sorted({v["name"] for v in creds.get("envVars", [])
                                    if v.get("mode") == "deny"})
        except (OSError, ValueError, KeyError, TypeError, AttributeError) as e:
            fail(3, f"cannot read the sandbox profile from {settings_path}: {e!r}")

    @staticmethod
    def read_rules(settings: dict, home: str, config_dir: Path) -> list[str]:
        paths = []
        for rule in settings.get("permissions", {}).get("deny", []):
            match = re.fullmatch(r"Read\((.+)\)", rule)
            if not match:
                continue
            spec = match.group(1).removesuffix("/**")
            if spec.startswith("//"):
                paths.append(spec[1:])
            elif spec.startswith("/"):
                paths.append(str(config_dir / spec[1:]))
            else:
                paths.append(absolute(home, spec, f"Read rule {rule}"))
        return paths

    def hidden(self, visible) -> list[str]:
        """Every path to hide that the jail could otherwise see. A glob rooted
        at / names no directory to search from; Claude's own sandbox skips
        those too."""
        out = []
        for pattern in self.blocked + self.rules:
            if not GLOB_CHARS.search(pattern):
                out += existing([pattern])
            elif literal_root(pattern) != "/" and visible(literal_root(pattern)):
                out += existing(glob.glob(pattern, recursive=True))
        kept: list[str] = []
        for path in sorted({p for p in out if visible(p)}):
            # bwrap cannot create a mount point inside an already hidden directory.
            if not any(under(path, k) for k in kept if os.path.isdir(k)):
                kept.append(path)
        return kept


@dataclass
class Repo:
    top: str
    git: list[str]          # the git dir, when it is inside top
    outside: list[str]      # git dirs elsewhere, read-only in the jail
    frozen: list[str]       # read-only, created as a stub when absent
    stubs: dict[str, str | None]  # absent protected path -> content (None: a directory)


def nested(top: str, gitdir: str | None) -> tuple[list[str], list[str]]:
    """Other checkouts below top, and agent config in its subdirectories: a
    session working in either has them protected, so the jail must too.
    A submodule kept under top's own git dir is not another checkout."""
    checkouts, config, stack = [], [], [top]
    while stack:
        here = stack.pop()
        try:
            entries = list(os.scandir(here))
        except OSError as e:
            fail(64, f"cannot look for checkouts in {here}: {e.strerror}")
        names = {e.name: e for e in entries}
        if here != top and ".git" in names:
            pointer = read_pointer(Path(here, ".git"), "gitdir:")
            target = os.path.realpath(os.path.join(here, pointer)) if pointer else ""
            if not (gitdir and under(target, os.path.join(gitdir, "modules"))):
                checkouts.append(here)
                continue
        if here != top:
            config += [e.path for e in entries if e.name in (".claude", ".mcp.json")
                       and not e.is_symlink()]
        stack += [e.path for e in entries
                  if e.name not in (".git", ".claude") and e.is_dir(follow_symlinks=False)]
    return checkouts, config


def repository(cwd: str, profile: Profile) -> Repo:
    start = Path(cwd)
    top = str(next((p for p in (start, *start.parents) if os.path.lexists(p / ".git")), start))

    def check(path: str, what: str) -> None:
        if not (any(under(path, r) for r in profile.roots) or under(path, "/tmp")):
            fail(64, f"{what} {path} is under no allowWrite root of the sandbox profile, nor /tmp")
        if any(under(r, path) for r in [*profile.roots, "/tmp"]):
            fail(64, f"{what} {path} is, or holds, a whole write root; work in a repository below it")
        if any(under(path, d) for d in profile.deny_write):
            fail(64, f"{what} {path} is under a denyWrite path of the sandbox profile")

    check(top, "the repository")
    if any(under(cwd, d) for d in profile.deny_write):
        fail(64, f"{cwd} is under a denyWrite path of the sandbox profile")
    dot = Path(top, ".git")
    own, outside, frozen = [], [], [os.path.join(top, name) for name in PROTECTED]
    gitdir = None
    # A stub in the worktree is an empty directory: git status does not list
    # it, and no file can be written in its place. Inside a git dir it is the
    # file git expects.
    content: dict[str, str] = {}
    # Only a git dir inside the repository is writable. One a pointer names
    # (a linked worktree's, or whatever was planted) is shown read-only, so no
    # pointer can make another repository writable.
    if dot.is_file() and not dot.is_symlink():
        frozen.append(str(dot))
        pointer = read_pointer(dot, "gitdir:")
        gitdir = os.path.realpath(dot.parent / pointer) if pointer else ""
        if not os.path.isfile(os.path.join(gitdir, "HEAD")):
            fail(64, f"cannot resolve the git dir of {top}")
        pointer = read_pointer(Path(gitdir, "commondir"))
        outside = [gitdir, os.path.realpath(os.path.join(gitdir, pointer)) if pointer else gitdir]
    elif dot.exists():
        gitdir = str(dot)
        own = [gitdir]
        pointer = read_pointer(Path(gitdir, "commondir"))
        if pointer not in (None, "."):
            outside = [os.path.realpath(os.path.join(gitdir, pointer))]
        frozen += [os.path.join(gitdir, name) for name in ("commondir", "config.worktree",
                                                           "hooks", "config")]
        # git dies on an empty commondir; "." names the git dir itself.
        content = {os.path.join(gitdir, "commondir"): ".", os.path.join(gitdir, "config"): "",
                   os.path.join(gitdir, "config.worktree"): ""}
        frozen += glob.glob(os.path.join(gitdir, "worktrees", "*", "commondir"))
        frozen += glob.glob(os.path.join(gitdir, "worktrees", "*", "config.worktree"))
        for root, dirs, files in os.walk(os.path.join(gitdir, "modules")):
            if "HEAD" in files:
                frozen += [os.path.join(root, "hooks"), os.path.join(root, "config")]
                dirs[:] = [d for d in dirs if d == "modules"]
    checkouts, config = nested(top, gitdir)
    # Under /tmp they are allowed, unguarded: the agent-e2e harness works there.
    if checkouts and not under(top, "/tmp"):
        fail(64, f"{top} holds another checkout, {checkouts[0]}; work in one repository")
    frozen += config
    outside = list(dict.fromkeys(outside))
    for d in outside:
        if under(d, top):
            fail(64, f"the git pointer in {top} names {d}, inside the repository; its hooks "
                     "and config could not be protected")
        check(d, "the git dir")
    for path in [os.path.join(top, ".claude"), os.path.join(top, ".git"), *frozen]:
        if os.path.islink(path):
            fail(64, f"{path} is a symlink; a jail could repoint it, so refusing to run here")
    stubs: dict[str, str | None] = {}
    for path in frozen:
        first = Path(path)
        while not os.path.lexists(first.parent):
            first = first.parent
        if Stubs.marked(str(first.parent)):
            stubs[str(first.parent)] = None
        elif not os.path.lexists(first):
            stubs[str(first)] = content.get(path) if first == Path(path) else None
        elif Stubs.marked(str(first)):
            stubs[str(first)] = content.get(path) if first == Path(path) else None
    return Repo(top, own, outside,
                [p for p in frozen if os.path.exists(p) and p not in stubs], stubs)


class Stubs:
    """Mount points for absent protected paths, the way Claude's sandbox makes
    them: created before the jail, removed after it. Marked and share-locked,
    so concurrent jails keep a stub until the last one using it is done.
    Created and removed through a descriptor of the checked parent, never by
    path: the caller may swap any directory above for a link meanwhile."""

    def __init__(self, wanted: dict[str, str | None]) -> None:
        self.held: list[tuple[int, str, int]] = []
        try:
            for path, content in wanted.items():
                parent, name = pinned(os.path.dirname(path)), os.path.basename(path)
                fd = self.make(parent, name, content)
                if fd is None:
                    fd = self.adopt(parent, name)
                if fd is None:
                    fail(3, f"cannot place a guard at {path}")
                fcntl.flock(fd, fcntl.LOCK_SH)
                self.held.append((parent, name, fd))
        except BaseException:
            self.remove()
            raise

    @staticmethod
    def make(parent: int, name: str, content: str | None) -> int | None:
        try:
            if content is None:
                os.mkdir(name, 0o755, dir_fd=parent)
                fd = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=parent)
            else:
                fd = os.open(name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644,
                             dir_fd=parent)
                os.write(fd, content.encode())
            os.setxattr(fd, STUB_MARK, b"1")
            return fd
        except FileExistsError:
            return None
        except OSError as e:
            fail(3, f"cannot place a guard named {name}: {e}")

    @staticmethod
    def marked(path: str) -> bool:
        try:
            os.getxattr(path, STUB_MARK, follow_symlinks=False)
            return True
        except OSError:
            return False

    @staticmethod
    def adopt(parent: int, name: str) -> int | None:
        try:
            fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=parent)
        except OSError:
            return None
        try:
            os.getxattr(fd, STUB_MARK)
            return fd
        except OSError:
            os.close(fd)
            return None

    def remove(self) -> None:
        for parent, name, fd in self.held:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                held = os.fstat(fd)
                now = os.stat(name, dir_fd=parent, follow_symlinks=False)
                if (held.st_dev, held.st_ino) != (now.st_dev, now.st_ino):
                    pass
                elif stat.S_ISDIR(now.st_mode):
                    os.rmdir(name, dir_fd=parent)
                elif held.st_size <= 1:
                    os.unlink(name, dir_fd=parent)
            except OSError:
                pass
            os.close(fd)
            os.close(parent)
        self.held = []


def host_addresses() -> list[str]:
    lines = Path("/proc/net/fib_trie").read_text().splitlines()
    return sorted({lines[i - 1].split()[-1] for i, line in enumerate(lines)
                   if "/32 host LOCAL" in line})


def resolvers() -> list[str]:
    found = re.findall(r"^\s*nameserver\s+(\d+\.\d+\.\d+\.\d+)\s*$",
                       Path("/etc/resolv.conf").read_text(), re.M)
    return sorted(set(found))


def egress_rules() -> str:
    lines = ["*filter", ":OUTPUT ACCEPT [0:0]", "-A OUTPUT -o lo -j ACCEPT"]
    lines += [f"-A OUTPUT -d {ns}/32 -p {proto} --dport 53 -j ACCEPT"
              for ns in resolvers() for proto in ("udp", "tcp")]
    lines += [f"-A OUTPUT -d {net} -j REJECT --reject-with icmp-admin-prohibited"
              for net in (*NON_GLOBAL, *(f"{a}/32" for a in host_addresses()))]
    return "\n".join([*lines, "COMMIT", ""])


def shared_tmp() -> str:
    path = f"/tmp/confined-{os.getuid()}"
    try:
        os.mkdir(path, 0o700)
    except FileExistsError:
        pass
    except OSError as e:
        fail(3, f"cannot create {path}: {e}")
    info = os.lstat(path)
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid():
        fail(3, f"{path} is not a directory of this user")
    return path


def pinned(path: str) -> int:
    """A descriptor for path, proven to be what was checked: bwrap binds it
    even if the caller swaps a directory for a symlink in the meantime."""
    try:
        fd = os.open(path, os.O_PATH | os.O_NOFOLLOW)
    except OSError as e:
        fail(64, f"cannot open {path}: {e}")
    if os.readlink(f"/proc/self/fd/{fd}") != path or stat.S_ISLNK(os.fstat(fd).st_mode):
        fail(64, f"{path} changed while it was being checked")
    return fd


def jail(profile: Profile, repo: Repo, cwd: str, home: str, tmp: str
         ) -> tuple[list[str], list[int]]:
    """bwrap's arguments and the descriptors they name."""
    creds = os.path.join(home, ".claude/.credentials.json")
    replaced = {"home": home, "/tmp": "/tmp", "/run": "/run", "/var": "/var"}
    reads = [os.path.join(replaced[top], rel) for top, rels in SHOWN.items() for rel in rels
             if os.path.exists(os.path.join(replaced[top], rel))]
    writes = [tmp, repo.top, *repo.git]
    bound = [*reads, *repo.outside, *writes, creds]

    def visible(path: str) -> bool:
        return not any(under(path, r) for r in replaced.values()) or \
            any(under(path, b) or under(b, path) for b in bound)

    # Claude's sandbox leaves the credentials file readable despite its Read
    # rule; agent e2e needs it, writable for token refresh. The sandbox block
    # still wins.
    real_creds = os.path.realpath(creds)
    hide = [h for h in profile.hidden(visible) if h != real_creds]
    for path in hide:
        if any(under(w, path) for w in writes):
            fail(64, f"{path} is hidden by the sandbox profile and holds the working repository")
    blocked = existing([b for b in profile.blocked if not GLOB_CHARS.search(b)])
    if not os.path.isfile(creds) or any(under(real_creds, h) for h in hide + blocked):
        creds = None
    args = ["--unshare-user", "--uid", str(os.getuid()), "--gid", str(os.getgid()),
            "--ro-bind", "/", "/", "--dev", "/dev", "--proc", "/proc",
            "--unshare-pid", "--unshare-ipc", "--new-session", "--die-with-parent",
            *(arg for r in replaced.values() for arg in ("--tmpfs", r))]
    if os.path.exists("/dev/net/tun"):
        args += ["--dev-bind", "/dev/net/tun", "/dev/net/tun"]
    for path in reads:
        args += ["--ro-bind", path, path]
    fds: list[int] = []

    def bind(option: str, source: str, dest: str) -> None:
        fds.append(pinned(source))
        args.extend([option, str(fds[-1]), dest])

    for path in repo.outside:
        bind("--ro-bind-fd", path, path)
    pins = [p for p in [os.path.join(repo.top, ".claude")] if os.path.isdir(p)]
    # Outer first: a later bind of an ancestor would cover a pin inside it.
    for path in sorted({*writes, *pins}, key=lambda p: p.count("/")):
        bind("--bind-fd", path, path)
    if creds:
        bind("--bind-fd", real_creds, creds)
    for path in [*(d for d in profile.deny_write if any(under(d, w) for w in writes)),
                 *repo.frozen, *repo.stubs]:
        bind("--ro-bind-fd", path, path)
    for path in hide:
        if os.path.isdir(path):
            args += ["--tmpfs", path, "--remount-ro", path]
        else:
            # --ro-bind would mount it nodev: reads fail EACCES instead of empty.
            args += ["--dev-bind", "/dev/null", path]
    for name in profile.deny_env:
        args += ["--unsetenv", name]
    return args + ["--setenv", "SANDBOX_RUNTIME", "1", "--setenv", "TMPDIR", tmp,
                   "--chdir", cwd], fds


def die_with_parent() -> None:
    ctypes.CDLL(None, use_errno=True).prctl(1, signal.SIGKILL)  # PR_SET_PDEATHSIG


class Network:
    """A user and network namespace whose root is the caller: the egress rules
    and pasta go in from outside, then bwrap maps the caller's uid inside it.
    Letting pasta create the namespace instead fails under no_new_privs (any
    enclosing bwrap): its command lacks the CAP_SETFCAP that mapping a
    namespace root needs."""

    def __init__(self, tools: dict[str, str]) -> None:
        ready_r, ready_w = os.pipe()
        self.hold_r, self.hold = os.pipe()
        self.pasta: list[int] = []
        self.pid = os.fork()
        if self.pid == 0:
            try:
                os.close(self.hold)
                os.close(ready_r)
                die_with_parent()
                os.unshare(os.CLONE_NEWUSER | os.CLONE_NEWNET)
                os.write(ready_w, b"x")
                os.read(self.hold_r, 1)
            finally:
                os._exit(0)
        os.close(ready_w)
        os.close(self.hold_r)
        try:
            if os.read(ready_r, 1) != b"x":
                fail(3, "cannot create a network namespace")
            for name, text in (("uid_map", f"0 {os.getuid()} 1"), ("setgroups", "deny"),
                               ("gid_map", f"0 {os.getgid()} 1")):
                Path(f"/proc/{self.pid}/{name}").write_text(text + "\n")
            rules = subprocess.run([tools["iptables-restore"]], input=egress_rules(), text=True,
                                   capture_output=True, preexec_fn=self.enter, env={})
            if rules.returncode != 0:
                fail(3, f"cannot load the egress rules: {rules.stderr.strip()}")
            ns = f"/proc/{self.pid}/ns"
            link = subprocess.run([tools["pasta"], *PASTA, "--userns", f"{ns}/user",
                                   "--netns", f"{ns}/net"], capture_output=True, text=True, env={})
            if link.returncode != 0:
                fail(3, f"pasta cannot connect the jail: {link.stderr.strip()}")
            # pasta went to the background and, this process being the
            # subreaper, is now its child. Left alone it notices the namespace
            # is gone only after a second.
            children = Path(f"/proc/self/task/{os.getpid()}/children").read_text().split()
            self.pasta = [int(c) for c in children if int(c) != self.pid]
        except BaseException:
            self.close()
            raise

    def enter(self) -> None:
        for kind, flag in (("user", os.CLONE_NEWUSER), ("net", os.CLONE_NEWNET)):
            fd = os.open(f"/proc/{self.pid}/ns/{kind}", os.O_RDONLY)
            os.setns(fd, flag)
            os.close(fd)

    def close(self) -> None:
        os.close(self.hold)
        os.waitpid(self.pid, 0)
        for pid in self.pasta:
            try:
                os.kill(pid, signal.SIGTERM)
            except ProcessLookupError:
                pass


def jail_is_empty(patience: float = 10.0) -> bool:
    """Whether every process of the jail is gone. As the subreaper this
    process inherits whatever outlives bwrap; a guard removed under a survivor
    would let it create the protected path."""
    deadline = time.monotonic() + patience
    while True:
        try:
            pid, _ = os.waitpid(-1, os.WNOHANG)
        except ChildProcessError:
            return True
        if pid == 0:
            if time.monotonic() > deadline:
                return False
            time.sleep(0.01)


def supervise(argv: list[str], fds: list[int], net: Network) -> int:
    child = subprocess.Popen(argv, pass_fds=fds,
                             preexec_fn=lambda: (die_with_parent(), net.enter()))
    try:
        for sig in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
            signal.signal(sig, lambda signum, _frame: child.send_signal(signum))
        status = child.wait()
    finally:
        if child.poll() is None:
            child.kill()
            child.wait()
    return 128 - status if status < 0 else status


def detach(args: Args, cwd: str, user: str, here: Path, tmp: str) -> None:
    systemd_run, bash = find("systemd-run", user), find("bash", user)
    recorder = here / "record-user-unit-failure"
    if not os.access(recorder, os.X_OK):
        fail(3, f"{recorder} is missing")
    log = f"{tmp}/{args.slug}.log"
    runtime = f"/run/user/{os.getuid()}"
    proc = subprocess.run(
        [systemd_run, "--user", "--quiet", "--expand-environment=no", f"--unit={args.slug}", f"--working-directory={cwd}",
         "-p", "RemainAfterExit=yes", "-p", f"RuntimeMaxSec={args.max_runtime or '4h'}",
         "-p", f"ExecStopPost={recorder} {args.slug} {log}",
         "--", sys.executable, "-I", str(here / "confined"), "--chdir", cwd, "--",
         bash, "-c", JOB_WRAPPER, "confined-job", log, *args.command],
        env={"XDG_RUNTIME_DIR": runtime, "DBUS_SESSION_BUS_ADDRESS": f"unix:path={runtime}/bus"},
        stdin=subprocess.DEVNULL, capture_output=True, text=True, check=False)
    if "already" in proc.stderr:
        fail(64, f"{args.slug}.service already exists: systemd keeps a finished unit and its "
                 "result, so a slug is single-use. Pick a new slug.")
    if proc.returncode != 0:
        fail(3, f"could not start {args.slug}.service: {proc.stderr.strip()}")
    print(f"confined: started {args.slug}.service log={log}")
    sys.exit(0)


def main() -> None:
    args = parse(sys.argv[1:])
    entry = pwd.getpwuid(os.getuid())
    here = Path(__file__).resolve().parent
    profile = Profile(here.parent / "settings.json", entry.pw_dir)
    try:
        cwd = os.path.realpath(args.chdir or os.getcwd(), strict=True)
    except OSError as e:
        fail(64, f"cannot resolve the working directory: {e}")
    repo = repository(cwd, profile)
    tmp = shared_tmp()
    tools = {name: find(name, entry.pw_name) for name in ("pasta", "bwrap", "iptables-restore")}
    for sig in (signal.SIGTERM, signal.SIGHUP):
        signal.signal(sig, lambda signum, _frame: sys.exit(128 + signum))
    if ctypes.CDLL(None, use_errno=True).prctl(36, 1) != 0:  # PR_SET_CHILD_SUBREAPER
        fail(3, "cannot become the subreaper that outlives the jail's processes")
    stubs = Stubs(repo.stubs)
    try:
        bwrap_args, fds = jail(profile, repo, cwd, entry.pw_dir, tmp)
        if args.slug:
            detach(args, cwd, entry.pw_name, here, tmp)
        net = Network(tools)
        try:
            status = supervise([tools["bwrap"], *bwrap_args, "--", *args.command], fds, net)
        finally:
            net.close()
    finally:
        if jail_is_empty():
            stubs.remove()
    sys.exit(status)


if __name__ == "__main__":
    main()
