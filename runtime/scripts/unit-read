#!/run/current-system/sw/bin/bash -p
# unit-read — read-only systemctl with every argument checked.
#
#   unit-read [--user] <verb> [options] [unit...]
#   verbs:   status show cat is-active is-failed is-enabled is-system-running
#            list-units list-timers list-unit-files list-dependencies
#   options: -p <Property[,Property]>  -n <lines>  --all  --failed
#            --state=<s[,s]>  --type=<t[,t]>   (no Environment, no SetCredential)
#   status names its units, without globs: it lists their processes.
#
# The Claude Code sandbox runs this outside itself, without a prompt, so it
# must not be steerable: systemctl accepts clustered and abbreviated options
# (`-aH host`, `--ho=host`), which no pattern over the command text can rule
# out. Hence an allowlist of whole arguments, and units after `--`.
set -uo pipefail
# The caller's environment can name unit files, a bus or a manager of its own
# (SYSTEMD_UNIT_PATH, DBUS_*, XDG_RUNTIME_DIR); even $UID is taken from it.
unset $(compgen -e) 2>/dev/null
export PATH=/run/current-system/sw/bin:/usr/bin:/bin
withheld='Environment|SetCredential|SetCredentialEncrypted'

usage() { sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//' >&2; exit 64; }

scope=()
if [ "${1:-}" = --user ]; then
  scope=(--user); shift
  export XDG_RUNTIME_DIR=/run/user/$(id -u)
fi
verb=${1:-}
[ $# -gt 0 ] && shift
case $verb in
  status|show|cat|is-active|is-failed|is-enabled|is-system-running) ;;
  list-units|list-timers|list-unit-files|list-dependencies) ;;
  *) usage ;;
esac

options=() units=()
while [ $# -gt 0 ]; do
  case $1 in
    -p) [[ ${2:-} =~ ^[A-Za-z]+(,[A-Za-z]+)*$ && ! ,$2, =~ ,($withheld), ]] || usage
        options+=(-p "$2"); shift 2 ;;
    -n) [[ ${2:-} =~ ^[0-9]+$ ]] || usage
        [[ $2 =~ ^0*([0-9]{1,5})$ ]] && lines=$((10#${BASH_REMATCH[1]})) || lines=10000
        options+=(-n "$((lines < 10000 ? lines : 10000))"); shift 2 ;;
    --all|--failed|--no-pager) options+=("$1"); shift ;;
    --state=*|--type=*) [[ $1 =~ ^--(state|type)=[a-z]+(,[a-z-]+)*$ ]] || usage; options+=("$1"); shift ;;
    -*) usage ;;
    *) [[ $1 =~ ^[A-Za-z0-9@._:*\\-]+$ ]] || usage; units+=("$1"); shift ;;
  esac
done
if [ "$verb" = status ]; then
  [ ${#units[@]} -gt 0 ] || usage
  for unit in "${units[@]}"; do case $unit in *[*?[]*) usage ;; esac; done
fi

case $verb in
  show|cat)
    # systemd.syntax: a trailing backslash continues the line, past comment lines.
    systemctl "${scope[@]}" --no-pager "$verb" "${options[@]}" -- "${units[@]}" |
      awk -v key="^[[:space:]]*($withheld)[[:space:]]*=" '
        held && /^[[:space:]]*[#;]/ { next }
        held || $0 ~ key { held = /\\$/; next }
        { print }' ;;
  status)
    # A slice's control group tree lists every process below it with its arguments.
    systemctl "${scope[@]}" --no-pager "$verb" "${options[@]}" -- "${units[@]}" |
      sed -E '/^[[:space:]]*(├|└|│|\|-|`-|\|[[:space:]])/d' ;;
  *) exec systemctl "${scope[@]}" --no-pager "$verb" "${options[@]}" -- "${units[@]}" ;;
esac
