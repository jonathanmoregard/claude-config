#!/usr/bin/env bash
# wait-for — block until something outside the session settles, then print one
# summary line and exit with a status that says how it settled.
#
# Run it with Bash `run_in_background: true` and end the turn. A main session
# can be re-invoked when its background call exits; a subagent is not promised
# that reinvocation. The durable systemd result is the guarantee: after any
# interruption, run the wait again. `RemainAfterExit=yes` keeps the unit result
# readable, and an undelivered failure record reaches the next SessionStart.
# That record is a failure backstop, never a success signal: silence is not
# evidence that a job passed.
#
# In a sandbox where gh cannot authenticate, pr/run mode reads a host watch
# started by the git-broker `github` tool from its protected status file. Each
# completed watch is reported once; later calls require a fresh host watch.
# Authenticated host behavior is unchanged.
#
#   wait-for pr <N> [-R owner/repo]        CI settled and GitHub's mergeability
#                                          computed (or the PR merged/closed);
#                                          a token without checks:read waits on
#                                          the Actions runs for the PR head
#   wait-for run <RUN_ID> [-R owner/repo]  one Actions run finished
#   wait-for unit <name> [--user] [--since now|<date>]
#                                          a systemd unit's run finished (a
#                                          transient systemd-run unit: its job
#                                          exited); with --since, a run that
#                                          STARTED after that moment
#   wait-for job <slug> [--timeout <s>] -- <cmd> [args...]
#                                          launch once as a retained user unit,
#                                          or adopt its recorded run, then wait
#   common: --timeout <seconds> (default 3600; job default 14400 so a
#                                          90-minute job does not time out)
#
# A retained unit keeps its result AND its name: `job` adopts it rather than
# relaunching, so a deliberate rerun of the same slug needs `systemctl --user
# stop <slug>.service` first. `reset-failed` does not unload a unit that
# finished successfully, and the relaunch then fails as "already loaded".
#
# `--since` rejects a run that started before the requested time. Do not capture
# `now` after launching a unit: that asks for a later run and can strand the
# already-finished unit as a timeout. A `job` launch owns the ordering and never
# passes `--since`.
#
# Exit: 0 settled fine · 1 settled badly (failed check/run/unit) ·
#       2 settled but not mergeable (conflict) or PR closed unmerged ·
#       3 settled, but its outcome could not be read · 124 timed out ·
#       64 usage error.
# The waiting inside is a loop on purpose: it runs detached in one background
# call, never in a foreground turn.
# END USAGE
set -uo pipefail

usage() {
  sed -n '2,/^# END USAGE$/p' "$0" | sed '$d; s/^# \{0,1\}//' >&2
  exit 64
}

[ $# -ge 2 ] || usage
mode=$1 target=$2
shift 2
repo=() repo_name="" user=() since="" job_cmd=()
if [ "$mode" = job ]; then timeout=14400; else timeout=3600; fi
if [ "$mode" = job ]; then
  while [ $# -gt 0 ] && [ "$1" != -- ]; do
    case $1 in
      --timeout) [ $# -ge 2 ] || usage; timeout=$2; shift 2 ;;
      *) usage ;;
    esac
  done
  [ "${1:-}" = -- ] || usage
  shift
  [ $# -gt 0 ] || usage
  job_cmd=("$@")
else
  while [ $# -gt 0 ]; do
    case $1 in
      -R|--repo) [ $# -ge 2 ] || usage; repo=(-R "$2"); repo_name=$2; shift 2 ;;
      --user) user=(--user); shift ;;
      --since) [ $# -ge 2 ] || usage; since=$2; shift 2 ;;
      --timeout) [ $# -ge 2 ] || usage; timeout=$2; shift 2 ;;
      *) usage ;;
    esac
  done
fi
case $timeout in ''|*[!0-9]*) usage ;; esac
deadline=$(( $(date +%s) + timeout ))
left() { echo $(( deadline - $(date +%s) )); }
# nap <step>: sleep up to <step> seconds, never past the deadline.
nap() { local l; l=$(left); [ "$l" -gt 0 ] || timed_out; sleep $(( l < $1 ? l : $1 )); }
timed_out() { echo "wait-for: timed out after ${timeout}s waiting on $mode $target"; exit 124; }

github_repo() {
  local value=$repo_name remote path owner name
  if [ -z "$value" ]; then
    remote=$(git remote get-url origin 2>/dev/null) || {
      echo "wait-for: cannot derive GitHub repository from origin" >&2
      return 1
    }
    case $remote in
      https://github.com/*) path=${remote#https://github.com/} ;;
      git@github.com:*) path=${remote#git@github.com:} ;;
      ssh://git@github.com/*) path=${remote#ssh://git@github.com/} ;;
      *) echo "wait-for: origin is not a supported github.com URL" >&2; return 1 ;;
    esac
    value=${path%.git}
  fi
  value=${value,,}
  if [[ ! $value =~ ^[a-z0-9][a-z0-9-]*/[a-z0-9._-]+$ ]]; then
    echo "wait-for: invalid GitHub repository: $value" >&2
    return 1
  fi
  owner=${value%%/*}; name=${value#*/}
  if [ "$name" = . ] || [ "$name" = .. ]; then
    echo "wait-for: invalid GitHub repository: $value" >&2
    return 1
  fi
  printf '%s/%s\n' "$owner" "$name"
}

wait_host_watch() {
  case $target in ''|*[!0-9]*) usage ;; esac
  local selected script_path policy status_dir status_file snapshot state exit_code line
  local line_encoded watch_id finished_at finished_utc marker_dir marker_file
  local marker_temp reported
  selected=$(github_repo) || exit 1
  script_path=$(readlink -f -- "$0") || {
    echo "wait-for: cannot resolve script path" >&2; exit 1;
  }
  policy=$(dirname "$script_path")/../mcps/git-broker/config.json
  status_dir=$(jq -er '.gitBroker.watchStatusDir | select(type == "string" and length > 0)' "$policy" 2>/dev/null) || {
    echo "wait-for: cannot read git-broker watchStatusDir policy" >&2; exit 1;
  }
  case $status_dir in
    %t) status_dir=/run/user/"$(id -u)" ;;
    %t/*) status_dir=/run/user/"$(id -u)"/${status_dir#%t/} ;;
  esac
  case $status_dir in /*) ;; *) echo "wait-for: watchStatusDir is not absolute" >&2; exit 1 ;; esac
  status_file=$status_dir/${selected%/*}/${selected#*/}/$mode-$target.json
  if [ ! -f "$status_file" ]; then
    echo "wait-for: gh cannot authenticate here and no host watch exists for $mode $target in $selected; start one with the git broker github tool (operation watch), then run wait-for again"
    exit 1
  fi
  while :; do
    snapshot=$(jq -er '
      def uint: type == "number" and . >= 0 and . == floor;
      if type != "object" then
        ["invalid", "", "", "", ""]
      elif .state == "watching" then
        ["watching", "", "", "", ""]
      elif (.state == "done"
            and ((.exit | type) == "number")
            and .exit >= 0 and .exit <= 255 and .exit == (.exit | floor)
            and (.started_at | uint) and (.finished_at | uint)
            and ((.watch_id | type) == "string")
            and (.watch_id | test("^[0-9a-f]{32}$"))
            and ((.line | type) == "string")) then
        ["done", (.exit | tostring), .watch_id,
         (.finished_at | tostring), (.line | @base64)]
      else
        ["invalid", "", "", "", ""]
      end | join("|")
    ' "$status_file" 2>/dev/null) || snapshot="invalid||||"
    IFS='|' read -r state exit_code watch_id finished_at line_encoded <<< "$snapshot"
    case $state in
      done)
        case $exit_code in ''|*[!0-9]*) echo "wait-for: invalid host watch result for $mode $target"; exit 1 ;; esac
        case $finished_at in ''|*[!0-9]*) echo "wait-for: invalid host watch result for $mode $target"; exit 1 ;; esac
        [ -n "$watch_id" ] || { echo "wait-for: invalid host watch result for $mode $target"; exit 1; }
        line=$(printf '%s' "$line_encoded" | base64 --decode 2>/dev/null) || {
          echo "wait-for: invalid host watch result for $mode $target"; exit 1;
        }
        [ -n "${HOME:-}" ] || { echo "wait-for: HOME is unavailable for host watch freshness tracking"; exit 1; }
        marker_dir=$HOME/.cache/git-broker/watch-reported/${selected%/*}/${selected#*/}
        marker_file=$marker_dir/$mode-$target
        mkdir -p -- "$marker_dir" || { echo "wait-for: cannot record host watch freshness"; exit 1; }
        if [ -L "$marker_file" ] || { [ -e "$marker_file" ] && [ ! -f "$marker_file" ]; }; then
          echo "wait-for: cannot record host watch freshness"
          exit 1
        fi
        reported=""
        if [ -f "$marker_file" ]; then
          IFS= read -r reported < "$marker_file" || reported=""
        fi
        if [ "$reported" = "$watch_id" ]; then
          finished_utc=$(date -u -d "@$finished_at" '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null) || {
            echo "wait-for: invalid host watch result for $mode $target"; exit 1;
          }
          echo "wait-for: the host watch result for $mode $target in $selected (finished $finished_utc) was already reported; start a new watch for a fresh result"
          exit 1
        fi
        marker_temp=$(mktemp "$marker_dir/.watch-reported.XXXXXX") || {
          echo "wait-for: cannot record host watch freshness"; exit 1;
        }
        printf '%s\n' "$watch_id" > "$marker_temp" || {
          rm -f -- "$marker_temp"
          echo "wait-for: cannot record host watch freshness"; exit 1;
        }
        mv -f -- "$marker_temp" "$marker_file" || {
          rm -f -- "$marker_temp"
          echo "wait-for: cannot record host watch freshness"; exit 1;
        }
        printf '%s\n' "$line"
        exit "$exit_code" ;;
      watching) nap 10 ;;
      *) echo "wait-for: invalid host watch status for $mode $target"; exit 1 ;;
    esac
  done
}

pr_field() { gh pr view "$target" "${repo[@]}" --json "$1" --jq ".$1" 2>/dev/null; }

wait_pr() {
  case $target in ''|*[!0-9]*) usage ;; esac
  local state checks_rc=0 m ms checks=n/a failed="?"
  state=$(pr_field state) || { echo "wait-for: cannot read PR $target"; exit 1; }
  if [ "$state" = OPEN ]; then
    # The exit code cannot tell checks from no checks (1 = a failed check,
    # "no checks reported", or an API error alike); the --json output can: a
    # JSON array means checks exist. "no checks reported" right after a push
    # may just mean not registered yet; any other error (e.g. a token without
    # checks:read) will not heal.
    local n=0 out
    while :; do
      out=$(gh pr checks "$target" "${repo[@]}" --json bucket 2>&1)
      if [[ $out == \[* ]]; then checks=present; break; fi
      if [[ $out == *"no checks reported"* ]]; then
        checks=none
        [ $n -lt 3 ] || break
        sleep 10; n=$((n + 1))
      else
        checks="unreadable (${out:0:80})"; break
      fi
    done
    if [ "$checks" = present ]; then
      [ "$(left)" -gt 0 ] || timed_out
      timeout "$(left)" gh pr checks "$target" "${repo[@]}" --watch --fail-fast \
        --interval 20 >/dev/null 2>&1
      checks_rc=$?
      [ $checks_rc = 124 ] && timed_out
    elif [[ $checks == unreadable* ]] && runs_settled; then
      checks="actions-runs failed=$failed (checks unreadable)"
    fi
    # mergeable is computed lazily: UNKNOWN right after a push or a base move.
    while :; do
      state=$(pr_field state); m=$(pr_field mergeable)
      [ "$state" != OPEN ] || [ "$m" != UNKNOWN ] && break
      nap 10
    done
  fi
  ms=$(pr_field mergeStateStatus)
  if [ "$checks" = present ]; then
    failed=$(gh pr checks "$target" "${repo[@]}" --json bucket \
      --jq '[.[] | select(.bucket == "fail" or .bucket == "cancel")] | length' 2>/dev/null || echo "?")
    checks="present failed=$failed"
  fi
  echo "PR #$target $state mergeable=${m:-n/a} mergeState=$ms checks=$checks"
  case $state in
    MERGED) exit 0 ;;
    CLOSED) exit 2 ;;
  esac
  [ "$failed" != 0 ] && [ "$failed" != "?" ] && exit 1
  [ "$m" = CONFLICTING ] && exit 2
  [[ $checks == unreadable* ]] && exit 3
  exit 0
}

# A conclusion that counts as a pass for a run or a check.
passed() { case $1 in success|skipped|neutral) return 0 ;; *) return 1 ;; esac; }

wait_run() {
  # `gh run watch` can exit early (rate limit, API hiccup) while the run is
  # still going, so its exit code is never the verdict: the run's own status
  # is. Re-watch until GitHub reports it completed.
  local line status conclusion
  while :; do
    [ "$(left)" -gt 0 ] || timed_out
    timeout "$(left)" gh run watch "$target" "${repo[@]}" --interval 30 >/dev/null 2>&1
    [ $? = 124 ] && timed_out
    line=$(gh run view "$target" "${repo[@]}" --json status,conclusion,name \
      --jq '"\(.status) \(.conclusion) \(.name)"' 2>/dev/null) || line=""
    read -r status conclusion _ <<<"$line"
    [ "$status" = completed ] && break
    nap 30
  done
  echo "run $target ${line#* * }: $status $conclusion"
  passed "$conclusion" && exit 0 || exit 1
}

# runs_settled: when the token cannot read checks, wait on the Actions runs
# for the PR head instead. Sets $failed to the count of runs that did not pass.
runs_settled() {
  local sha out busy n=0
  sha=$(pr_field headRefOid) || return 1
  [ -n "$sha" ] || return 1
  while :; do
    out=$(gh run list "${repo[@]}" --commit "$sha" --limit 100 \
      --json status,conclusion,name 2>/dev/null) || return 1
    busy=$(jq '[.[] | select(.status != "completed")] | length' <<<"$out")
    if [ "$(jq length <<<"$out")" = 0 ]; then
      # Runs register a few seconds after a push; none after ~2 min = none.
      [ $n -lt 12 ] || { failed=0; return 0; }
      n=$((n + 1))
    elif [ "$busy" = 0 ]; then
      failed=$(jq '[.[] | select(.conclusion as $c
        | ["success","skipped","neutral"] | index($c) | not)] | length' <<<"$out")
      return 0
    fi
    nap 20
  done
}

unit_prop() { systemctl "${user[@]}" show "$target" -p "$1" --value 2>/dev/null; }
to_epoch() { [ -n "$1" ] && [ "$1" != n/a ] && date -d "$1" +%s 2>/dev/null || echo 0; }

# Read several properties in ONE `systemctl show`, so they all describe the same
# instant. Reading them one at a time leaves a window — measured 7 ms per pair
# on this host — in which a collecting unit vanishes between two reads, after
# which the later reads answer with not-found DEFAULTS. Those defaults are
# `LoadState=not-found Transient=no CollectMode=inactive Result=success
# ExecMainStatus=0`: a mix of instants can therefore make a failed run look like
# a clean one, which is the entire class of bug this script exists to remove.
# `--value` is deliberately unused: with several `-p` flags systemd prints the
# values in its own property order, not the requested one, so they must be read
# back by key.
unit_prop_snapshot() {
  local args=() p
  for p in "$@"; do args+=(-p "$p"); done
  systemctl "${user[@]}" show "$target" "${args[@]}" 2>/dev/null
}

snapshot_field() {
  local snapshot=$1 key=$2 line
  while IFS= read -r line; do
    case $line in "$key="*) printf '%s\n' "${line#"$key="}"; return 0 ;; esac
  done <<<"$snapshot"
  return 0
}

failure_record() {
  local key=${target%.service}
  [ "${user[*]:-}" = --user ] || return 1
  [[ $key =~ ^[A-Za-z0-9._-]+$ ]] || return 1
  [ -n "${HOME:-}" ] || return 1
  printf '%s/.local/state/claude-unit-failures/%s.json\n' "$HOME" "$key"
}

clear_reported_failure() {
  local record
  record=$(failure_record) || return 0
  rm -f -- "$record" ||
    echo "wait-for: reported the failure but could not clear $record" >&2
}

# A success supersedes an older undelivered failure for the same unit name.
# Nothing else can clear it: `RemainAfterExit=yes` keeps the successful unit
# active, so that unit's own `ExecStopPost` has not run and will not run until
# someone stops it. Measured without this: after a failed run, a `stop` and a
# successful rerun, every SessionStart kept announcing the fixed job.
#
# Only a record OLDER than the run just verified is cleared. If it is newer, or
# either timestamp is unreadable, the record is KEPT: a stale announcement is
# noise, while dropping a real failure is silence, and silence is the failure
# mode this script exists to remove.
clear_superseded_failure() {
  local run_started=$1 record record_at record_epoch run_epoch
  record=$(failure_record) || return 0
  [ -f "$record" ] || return 0
  record_at=$(jq -r '.failed_at // empty' "$record" 2>/dev/null)
  record_epoch=$(to_epoch "$record_at")
  run_epoch=$(to_epoch "$run_started")
  [ "$record_epoch" -gt 0 ] && [ "$run_epoch" -gt 0 ] || return 0
  [ "$record_epoch" -le "$run_epoch" ] || return 0
  rm -f -- "$record" ||
    echo "wait-for: $target succeeded but its superseded failure record $record could not be cleared" >&2
}

# A vanished unit's outcome is read from the journal, never inferred from its
# absence. Measured on this host (2026-11-03), systemd logs, per run:
#   39f5…  "Started …"                    — every run, success or failure
#   98e3…  "Main process exited, …"        — failures only, carries EXIT_STATUS
#   d9b3…  "Failed with result '…'"        — failures only
# A clean exit logs ONLY the "Started" record. So that record is the presence
# proof that separates "ran and succeeded" from "the journal cannot be read":
# a failure verdict needs a failure record, and a success verdict needs the
# Started record for the same run. Neither is absence-as-evidence.
JOURNAL_STARTED_ID=39f53479d3a045ac8e11786248231fbf
JOURNAL_EXITED_ID=98e322203f7a4ed290d09fe03c09fe15
JOURNAL_FAILED_ID=d9b373ed55a64feb8242e02dbe79a49c

# The exit record is written by the service MANAGER, not by the unit's own
# process, so `_SYSTEMD_INVOCATION_ID` is the manager's. The unit's own
# InvocationID appears as USER_INVOCATION_ID for --user units and
# INVOCATION_ID for system units. Measured: equal to `systemctl show
# -p InvocationID`.
invocation_field() {
  [ "${user[*]:-}" = --user ] && echo USER_INVOCATION_ID || echo INVOCATION_ID
}

journal_records() {
  local invocation=$1 started_at=$2
  if [ -n "$invocation" ]; then
    journalctl "${user[@]}" "$(invocation_field)=$invocation" -o json --no-pager 2>/dev/null
  elif [ -n "$started_at" ] && [ "$started_at" != n/a ]; then
    # InvocationID is normally available. If it races away, the captured start
    # TIMESTAMP (a date string, not an epoch) is the narrowest scope left.
    journalctl "${user[@]}" -u "$target" --since "$started_at" -o json --no-pager 2>/dev/null
  else
    return 1
  fi
}

# Prints "<exit status>", "failed", or "ok"; returns 1 when nothing is readable.
# Two jq details matter here and are easy to get wrong:
#   1. `empty as $x | …` emits NOTHING, so a missing exit record must bind to
#      null (via `[…] | last`) and be tested with `!= null`, never bound with
#      `// empty`. Getting that wrong silently turns every success into
#      "could not determine".
#   2. Input is slurped (`-s`), so membership tests need `any(.[]; cond)`.
journal_verdict() {
  local invocation=$1 started_at=$2
  journal_records "$invocation" "$started_at" | jq -rs \
    --arg started "$JOURNAL_STARTED_ID" \
    --arg exited "$JOURNAL_EXITED_ID" \
    --arg failed "$JOURNAL_FAILED_ID" '
      ([.[] | select(.MESSAGE_ID == $exited and has("EXIT_STATUS"))
             | .EXIT_STATUS] | last)     as $status
    | any(.[]; .MESSAGE_ID == $failed)   as $didfail
    | any(.[]; .MESSAGE_ID == $started)  as $didstart
    | if   $status != null then ($status | tostring)
      elif $didfail        then "failed"
      elif $didstart       then "ok"
      else empty end
    ' 2>/dev/null | grep . || return 1
}

latest_invocation() {
  local since_args=()
  [ -z "$since" ] || since_args=(--since "$since")
  journalctl "${user[@]}" -u "$target" "${since_args[@]}" -o json --no-pager 2>/dev/null |
    jq -rs --arg field "$(invocation_field)" '
      map(select((.[$field] // "") | length > 0)) | last | .[$field] // empty
    ' 2>/dev/null
}

report_vanished_unit() {
  local invocation=$1 started_at=$2 collect_mode=$3 verdict
  if [ -z "$invocation" ]; then
    # A unit already gone at arm time has no systemctl identity left. Use the
    # name only to discover the latest invocation, then scope the verdict read
    # to that run so a reused name cannot mix journal records.
    invocation=$(latest_invocation)
  fi
  verdict=$(journal_verdict "$invocation" "$started_at") || {
    echo "wait-for: unit $target vanished and its outcome could not be determined (collect-mode=${collect_mode:-unknown})"
    exit 3
  }
  case $verdict in
    ok)
      echo "unit $target vanished after a clean exit; journal shows no failure for invocation=${invocation:-unknown}"
      clear_superseded_failure "$started_at"
      exit 0 ;;
    failed)
      echo "unit $target vanished; journal result=failed status=unknown invocation=${invocation:-unknown}"
      clear_reported_failure
      exit 1 ;;
    0)
      echo "unit $target vanished; journal result=success status=0 invocation=${invocation:-unknown}"
      clear_superseded_failure "$started_at"
      exit 0 ;;
    *)
      echo "unit $target vanished; journal result=exit-code status=$verdict invocation=${invocation:-unknown}"
      clear_reported_failure
      exit 1 ;;
  esac
}

wait_unit() {
  local since_epoch=0
  if [ -n "$since" ]; then
    since_epoch=$(to_epoch "$since"); [ "$since_epoch" -gt 0 ] || usage
  fi
  local armed iter final load state started started_at transient collect_mode
  local invocation result status
  # One snapshot, so the identity used for the journal fallback describes the
  # same instant as the LoadState that admitted it.
  # `started_at` keeps the systemd timestamp STRING for the journal fallback's
  # `--since`; `started` below is an epoch integer for the `--since` comparison.
  # They are deliberately separate: feeding an epoch to `--since` is not a date.
  armed=$(unit_prop_snapshot LoadState Transient CollectMode InvocationID \
                             ExecMainStartTimestamp)
  load=$(snapshot_field "$armed" LoadState)
  transient=$(snapshot_field "$armed" Transient)
  collect_mode=$(snapshot_field "$armed" CollectMode)
  invocation=$(snapshot_field "$armed" InvocationID)
  started_at=$(snapshot_field "$armed" ExecMainStartTimestamp)
  if [ "$load" != loaded ]; then
    # Nothing in this snapshot is a fact about a real unit: every field is a
    # not-found default, CollectMode included. Say unknown rather than repeat
    # a default as an observation.
    report_vanished_unit "" "" unknown
  fi
  while :; do
    iter=$(unit_prop_snapshot LoadState ActiveState SubState Type \
                              ExecMainStartTimestamp)
    # A unit that stops being loaded cannot be read through systemctl at all;
    # every property in this snapshot would be a not-found default, and those
    # defaults read exactly like a pass. The journal decides instead.
    #
    # The cached `transient` flag is deliberately NOT part of this condition.
    # It used to gate the check, which made the bug self-concealing: if the
    # unit vanished while the arming reads were in flight, `Transient` answered
    # with its own default `no`, the gate could never fire, and the run was
    # reported from `Result=success ExecMainStatus=0`. Whether a unit is
    # transient is irrelevant here — being unloaded is what makes its
    # properties unreadable.
    if [ "$(snapshot_field "$iter" LoadState)" != loaded ]; then
      report_vanished_unit "$invocation" "$started_at" "$collect_mode"
    fi
    state=$(snapshot_field "$iter" ActiveState)
    started=$(to_epoch "$(snapshot_field "$iter" ExecMainStartTimestamp)")
    case $state in
      activating|deactivating|reloading|refreshing) ;;
      active)
        # A oneshot is active/start while it runs and active/exited after it
        # (RemainAfterExit). A transient unit (systemd-run) is a job, so active
        # means still running. Any other type is "up" once active.
        if [ "$transient" != yes ] && { [ "$(snapshot_field "$iter" Type)" != oneshot ] ||
          [ "$(snapshot_field "$iter" SubState)" = exited ]; }; then
          [ "$started" -ge "$since_epoch" ] && break
        fi
        [ "$transient" = yes ] && [ "$(snapshot_field "$iter" SubState)" = exited ] && break ;;
      *)
        # inactive/failed: done, unless --since asks for a run not yet begun.
        if [ "$since_epoch" = 0 ] || [ "$started" -ge "$since_epoch" ]; then break; fi ;;
    esac
    nap 5
  done
  # The verdict is read as one snapshot too, and re-checks LoadState: a unit
  # reaped between breaking out of the loop and reading its result would
  # otherwise be reported from the not-found defaults.
  final=$(unit_prop_snapshot LoadState ActiveState SubState Result \
                             ExecMainStatus ExecMainStartTimestamp)
  if [ "$(snapshot_field "$final" LoadState)" != loaded ]; then
    report_vanished_unit "$invocation" "$started_at" "$collect_mode"
  fi
  result=$(snapshot_field "$final" Result)
  status=$(snapshot_field "$final" ExecMainStatus)
  started_at=$(snapshot_field "$final" ExecMainStartTimestamp)
  echo "unit $target $(snapshot_field "$final" ActiveState)/$(snapshot_field "$final" SubState) result=$result status=$status started=$started_at"
  if [ "$result" = success ]; then
    clear_superseded_failure "$started_at"
    exit 0
  fi
  clear_reported_failure
  exit 1
}

wait_job() {
  [[ $target =~ ^[A-Za-z0-9._-]+$ && $target != . && $target != .. ]] || {
    echo "wait-for: invalid job slug '$target' (use only letters, digits, dot, underscore and hyphen)" >&2
    exit 64
  }
  [[ $target != claude-* ]] || {
    echo "wait-for: job slugs beginning with claude- are reserved" >&2
    exit 64
  }
  local arg script_path recorder log state substate
  for arg in "${job_cmd[@]}"; do
    if [ "$arg" = --collect ]; then
      echo "wait-for: --collect is refused: it can reap a failed transient unit and make systemctl report not-found defaults instead of the failure" >&2
      exit 64
    fi
  done
  user=(--user)
  if [ "$(unit_prop LoadState)" != loaded ]; then
    script_path=$(readlink -f -- "$0") || {
      echo "wait-for: cannot resolve recorder path" >&2; exit 3;
    }
    recorder=$(dirname "$script_path")/record-user-unit-failure
    [ -x "$recorder" ] || {
      echo "wait-for: failure recorder is unavailable: $recorder" >&2; exit 3;
    }
    log=/tmp/$target.log
    systemd-run --user --unit="$target" --working-directory="$PWD" \
      -p RemainAfterExit=yes \
      -p "ExecStopPost=$recorder $target $log" -- \
      bash -c '
        log=$1; shift
        "$@" >"$log" 2>&1; rc=$?
        if [ "$rc" = 0 ]; then
          echo MARKER_OK >>"$log"
        else
          echo "MARKER_FAILED rc=$rc" >>"$log"
        fi
        exit "$rc"
      ' wait-for-job "$log" "${job_cmd[@]}" >/dev/null || {
        echo "wait-for: could not launch job $target" >&2; exit 3;
      }
  else
    state=$(unit_prop ActiveState); substate=$(unit_prop SubState)
    echo "wait-for: adopting job $target ($state/$substate)"
  fi
  wait_unit
}

case $mode in
  pr|run)
    if ! gh auth token >/dev/null 2>&1; then wait_host_watch; fi ;;
esac

case $mode in
  pr) wait_pr ;;
  run) wait_run ;;
  unit) wait_unit ;;
  job) wait_job ;;
  *) usage ;;
esac
