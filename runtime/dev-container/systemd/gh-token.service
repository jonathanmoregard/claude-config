[Unit]
Description=Rotate GitHub App installation tokens (host + active Claude sandboxes)

# Mirror of the declarative unit in nixos-config home/claude-services.nix,
# which also pins PATH (coreutils curl gnused jq openssl) and creates
# ~/.cache/gh-tokens/host/scope and host/klaffat/ (0700, the org
# installation's token dir) via tmpfiles.

[Service]
Type=oneshot
ExecStart=%h/.claude/dev-container/bin/mint-gh-token
Nice=5

# Hardening (H-B, advice-refine round 1)
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.cache/gh-tokens
ReadOnlyPaths=%h/.config/github-app/app.pem
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=128M
TasksMax=32
