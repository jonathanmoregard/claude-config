#!/usr/bin/env python3
"""Launcher for ai-router (tools/ai-router/ai_router). Resolves symlinks so
~/.claude/bin/ai-router works from any cwd and any host CLI."""
import os
import sys

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, os.path.join(os.path.dirname(HERE), "tools", "ai-router"))

from ai_router.cli import main  # noqa: E402

sys.exit(main())
