{
  "_comment": [
    "Untrusted-ingress vocabulary for hooks/bash-output-guard.py.",
    "Moved out of mcps/safe-bash/bash-config.json, whose Bash(...) deny globs",
    "now live in settings.json permissions.deny instead. Kept as data so the",
    "list can be edited without touching the guard.",
    "A command whose head matches untrusted_ingress_single, or whose leading",
    "tokens match an untrusted_ingress_multi prefix, has its output wrapped in",
    "<untrusted_external_content> before the model sees it. Wrapping is",
    "deliberately selective: tagging everything desensitises the model to the",
    "tag."
  ],
  "untrusted_ingress_single": {
    "curl": "curl",
    "wget": "wget",
    "npx": "npx"
  },
  "untrusted_ingress_multi": [
    { "prefix": ["gh", "pr", "view"], "label": "gh-fetch" },
    { "prefix": ["gh", "pr", "diff"], "label": "gh-fetch" },
    { "prefix": ["gh", "pr", "comment"], "label": "gh-fetch" },
    { "prefix": ["gh", "pr", "list"], "label": "gh-fetch" },
    { "prefix": ["gh", "issue", "view"], "label": "gh-fetch" },
    { "prefix": ["gh", "issue", "comment"], "label": "gh-fetch" },
    { "prefix": ["gh", "issue", "list"], "label": "gh-fetch" },
    { "prefix": ["gh", "api"], "label": "gh-api" },
    { "prefix": ["git", "clone"], "label": "git-clone" },
    { "prefix": ["pip", "install"], "label": "pip-install" },
    { "prefix": ["pip3", "install"], "label": "pip-install" },
    { "prefix": ["npm", "install"], "label": "npm-install" },
    { "prefix": ["npm", "i"], "label": "npm-install" },
    { "prefix": ["npm", "ci"], "label": "npm-install" },
    { "prefix": ["cargo", "install"], "label": "cargo-install" },
    { "prefix": ["gem", "install"], "label": "gem-install" },
    { "prefix": ["go", "install"], "label": "go-fetch" },
    { "prefix": ["go", "get"], "label": "go-fetch" },
    { "prefix": ["bundle", "install"], "label": "bundle-install" }
  ]
}
