[Unit]
Description=Vet container-captured CL-v2 observations and merge to host homunculus
After=default.target

[Service]
Type=oneshot
ExecStart=%h/.claude/dev-container/.venv/bin/python3 %h/.claude/dev-container/bin/claude-cl-sync
Nice=10
# Skip .pyc writes so we don't need to grant write to the editable
# injection-scanner source tree or the venv site-packages.
Environment=PYTHONDONTWRITEBYTECODE=1

# Hardening (H-B, advice-refine round 1)
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
# Writable: host homunculus (approved lands here) + per-project staging
# dirs (rotate + quarantine).
ReadWritePaths=%h/.claude/homunculus %h/.claude/container-staging
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=1G
TasksMax=256
