#!/usr/bin/env python3
"""Vet container-captured CL-v2 observations and merge approved ones into the
host homunculus store.

Hardened post-advisor review (2026-04-21):

  F1/F2  Strict field allowlist. Each JSONL record is rebuilt as a canonical
         dict with only known CL-v2 keys. Unknown keys → reject. The scanner
         sees the canonical JSON once (no duplicate/escaped views). The
         *canonical* record is appended to host homunculus — never the raw
         line — so attacker-planted fields can never sneak past the scanner.

  F3     Atomic rotate-then-process. Rename `observations.jsonl` to
         `.sync-<ts>` before reading; container continues appending to a
         fresh file. No truncate race.

  F9     Pre-sync self-test. Feed a known canary through the scanner; abort
         if it passes. Blocks silent scanner regressions from leaking
         secrets to host.
"""
from __future__ import annotations

import fcntl
import json
import logging
import os
import shutil
import sys
import tempfile
import time
import uuid
from pathlib import Path

HOME = Path(os.environ["HOME"])
STAGING_ROOT = HOME / ".claude" / "container-staging"
HOST_HOMUNC = HOME / ".claude" / "homunculus"

try:
    from injection_scanner.intercept import scan as intercept_scan
except ImportError as e:
    sys.stderr.write(
        "claude-cl-sync: cannot import injection_scanner.intercept. "
        "Under systemd this is auto-installed by claude-cl-sync.service "
        "ExecStartPre into ~/.claude/dev-container/.venv/. For manual "
        "testing: `uv pip install --python ~/.claude/dev-container/.venv/bin/python3 "
        "injection-scanner@git+https://github.com/jonathanmoregard/injection-scanner@main` "
        "(or `-e ~/Repos/injection-scanner` for an editable local clone). "
        f"Original error: {e}\n"
    )
    sys.exit(1)

# Exact field set observe.sh produces. Anything outside these per-event
# shapes is a downgrade-attempt or a CL-v2 version drift; reject + surface.
#
# Every event shares (timestamp, event, session, project_id, project_name).
# tool_start / tool_complete additionally carry (tool, input, output).
# parse_error carries (raw) instead of (tool/input/output) — CL-v2 emits it
# when the upstream hook JSON was malformed.
#
# Cross-variant contamination (a tool_complete carrying a rogue `raw`, or a
# parse_error with `input`/`output`) is what the per-event allowlists below
# block — not just "unknown" keys.
_COMMON_KEYS = {"timestamp", "event", "session", "project_id", "project_name"}
_TOOL_KEYS   = _COMMON_KEYS | {"tool", "input", "output"}
_PARSE_KEYS  = _COMMON_KEYS | {"raw"}

OBS_EVENT_SCHEMA: dict[str, dict] = {
    "tool_start":    {"allowed": _TOOL_KEYS,  "required": _COMMON_KEYS | {"tool"}},
    "tool_complete": {"allowed": _TOOL_KEYS,  "required": _COMMON_KEYS | {"tool"}},
    "parse_error":   {"allowed": _PARSE_KEYS, "required": _COMMON_KEYS | {"raw"}},
}
OBS_EVENTS = set(OBS_EVENT_SCHEMA.keys())


def canonicalize(obs: dict) -> tuple[bool, dict, str]:
    """Return (ok, canonical_dict, reason). Strict per-event schema:
    missing required → reject; extra-for-variant → reject.
    """
    if not isinstance(obs, dict):
        return False, {}, "not-object"
    if "event" not in obs:
        return False, {}, "missing-required:event"
    ev = obs["event"]
    schema = OBS_EVENT_SCHEMA.get(ev)
    if schema is None:
        return False, {}, f"unknown-event:{ev}"
    missing = schema["required"] - obs.keys()
    if missing:
        return False, {}, f"missing-required:{','.join(sorted(missing))}"
    unknown = set(obs.keys()) - schema["allowed"]
    if unknown:
        return False, {}, f"unexpected-keys-for-{ev}:{','.join(sorted(unknown))}"
    canonical = {k: obs[k] for k in sorted(schema["allowed"]) if k in obs}
    return True, canonical, "ok"


def smoke_test() -> None:
    """F9: fail fast on scanner regression. Delegates to the shared
    canary set in injection_scanner.smoke so cl-sync and research-agent
    can't drift apart.
    """
    from injection_scanner.smoke import run_smoke, SmokeFailure
    try:
        run_smoke(log_info=logging.info, log_error=logging.error)
    except SmokeFailure:
        sys.exit(2)


def quarantine_record(project_dir: Path, record: dict | str, reason: str, audit: dict | None = None) -> Path:
    q = project_dir / "quarantine"
    q.mkdir(parents=True, exist_ok=True)
    path = q / f"{int(time.time())}-{uuid.uuid4().hex[:8]}.json"
    payload = {
        "reason": reason,
        "record": record,
        "verdict": audit,
        "at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
    }
    path.write_text(json.dumps(payload, default=str), encoding="utf-8")
    return path


def mirror_target(rotated_file: Path, project_dir: Path) -> Path:
    """Translate staging/<project>/homunculus/<rel>.sync-<ts> → host homunculus/<rel>."""
    rel = rotated_file.relative_to(project_dir / "homunculus")
    # strip the .sync-<ts> suffix for the host-side name
    stem = rel.with_suffix("")  # "observations.jsonl.sync-<ts>" → "observations.jsonl"
    # .jsonl stays on `observations`; .sync-... was appended so with_suffix strips only `.sync-<ts>`.
    # Belt-and-braces: rebuild explicit "observations.jsonl" name.
    target_name = rel.name.split(".sync-")[0]
    return HOST_HOMUNC / rel.parent / target_name


def rotate_jsonl(staging_file: Path) -> Path | None:
    """Safely grab a batch of observations.

    Races against `observe.sh >> observations.jsonl`: if we rename, any hook
    that already opened the fd keeps writing into the rotated inode, and those
    records get dropped when we unlink. To avoid that, we hold an exclusive
    advisory lock on a per-file `.lock` while we copy+truncate. observe.sh
    does not take this lock today, but per-hook appends are a single small
    write each, and a brief `fcntl.flock` on the staging file itself via
    O_APPEND is atomic at the write level on Linux — so the *worst* race is
    one append landing in a post-truncate gap, which simply shows up in the
    next batch.

    Strategy here: rotate via copy+truncate under a flock on the *lockfile*,
    not the staging file. Two concurrent syncs serialize cleanly. The writer
    (observe.sh) doesn't participate; its append-writes happen in whichever
    inode is active at that moment, which is always an existing file.
    """
    if not staging_file.exists() or staging_file.stat().st_size == 0:
        return None
    lock_path = staging_file.with_suffix(staging_file.suffix + ".lock")
    suffix = f".sync-{int(time.time())}-{uuid.uuid4().hex[:6]}"
    rotated = staging_file.with_name(staging_file.name + suffix)
    lf = lock_path.open("a+")
    try:
        try:
            fcntl.flock(lf.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            logging.info("another sync holds %s — skipping this file for now", lock_path)
            return None
        # copy current contents, then truncate in place so observe.sh's
        # O_APPEND fd keeps writing to the same inode after us.
        try:
            with staging_file.open("rb") as src:
                data = src.read()
            if not data.strip():
                return None
            with rotated.open("wb") as dst:
                dst.write(data)
            # Open for truncate, not unlink. Preserves the inode + any
            # observe.sh fd already pointing at it.
            with staging_file.open("r+b") as tf:
                tf.truncate(0)
        except FileNotFoundError:
            # Another sync won the rotate race; fine, bail out.
            try:
                rotated.unlink()
            except FileNotFoundError:
                pass
            return None
    finally:
        try:
            fcntl.flock(lf.fileno(), fcntl.LOCK_UN)
        except OSError:
            pass
        lf.close()
    return rotated


# Per-line cap so one giant record doesn't waste scanner cost / RAM.
# Typical well-formed observations are a few KB at most.
MAX_LINE_BYTES = 64 * 1024

# Whole-file cap. A rotated file larger than this is either a runaway
# logger or an attempt to OOM the vetter; quarantine wholesale instead
# of streaming it through the scanner line by line.
MAX_ROTATED_BYTES = 64 * 1024 * 1024  # 64 MiB


def _stream_lf_lines(f, chunk_size: int = 64 * 1024):
    """Yield LF-delimited (bytes) records from `f` without loading the
    whole file. Strict on LF only — not `splitlines`, which also splits
    on \\r / U+2028 / U+2029 etc. A record longer than MAX_LINE_BYTES
    is yielded as-is (caller decides to quarantine) so the streaming
    layer doesn't hide oversize attacks.
    """
    buf = b""
    while True:
        chunk = f.read(chunk_size)
        if not chunk:
            break
        buf += chunk
        while True:
            nl = buf.find(b"\n")
            if nl < 0:
                break
            line, buf = buf[:nl], buf[nl + 1:]
            if line.strip():
                yield line
            # Early-cap: if the remainder grows past MAX_LINE_BYTES
            # before we find a newline, yield it as one oversize record
            # so the caller quarantines and releases memory.
        if len(buf) > MAX_LINE_BYTES:
            yield buf
            buf = b""
    if buf.strip():
        yield buf


def process_rotated(rotated_file: Path, project_dir: Path) -> tuple[int, int, int]:
    """Returns (approved, quarantined, errors)."""
    approved = quarantined = errors = 0
    host_path = mirror_target(rotated_file, project_dir)
    host_path.parent.mkdir(parents=True, exist_ok=True)

    # Whole-file size guard: fail-closed before loading/streaming.
    try:
        total_bytes = rotated_file.stat().st_size
    except FileNotFoundError:
        return 0, 0, 0
    if total_bytes > MAX_ROTATED_BYTES:
        quarantine_record(
            project_dir,
            f"<oversize rotated file: {total_bytes} bytes>",
            f"rotated-oversize:{total_bytes}b>max{MAX_ROTATED_BYTES}b",
            None,
        )
        # Move the offending file into quarantine rather than deleting so
        # the human can look at it.
        qdest = project_dir / "quarantine" / rotated_file.name
        qdest.parent.mkdir(parents=True, exist_ok=True)
        shutil.move(str(rotated_file), qdest)
        return 0, 1, 0

    with rotated_file.open("rb") as f:
      for raw in _stream_lf_lines(f):
        # Size cap
        if len(raw) > MAX_LINE_BYTES:
            quarantine_record(project_dir, raw[:200].decode("utf-8", "replace") + "…",
                              f"oversize:{len(raw)}b>max{MAX_LINE_BYTES}b", None)
            quarantined += 1
            continue

        # UTF-8 decode; non-UTF-8 is a downgrade attempt or corruption either way.
        try:
            line = raw.decode("utf-8")
        except UnicodeDecodeError as e:
            quarantine_record(project_dir, repr(raw[:200]),
                              f"not-utf8:{e.reason}@{e.start}", None)
            quarantined += 1
            continue

        # Parse
        try:
            obs = json.loads(line)
        except json.JSONDecodeError:
            quarantine_record(project_dir, line, "not-json", None)
            quarantined += 1
            continue

        # Canonicalize (F1+F2): reject anything outside the allowlist.
        ok_canon, canonical, canon_reason = canonicalize(obs)
        if not ok_canon:
            quarantine_record(project_dir, obs, f"canonicalize:{canon_reason}", None)
            quarantined += 1
            continue

        # Scan only the canonical record as a single representation (F2).
        canonical_line = json.dumps(canonical, default=str, ensure_ascii=False)
        with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False) as tf:
            tf.write(canonical_line)
            tpath = Path(tf.name)
        try:
            try:
                verdict = intercept_scan(tpath, use_honeypot=True)
            except Exception as e:
                logging.exception("scan crashed: %s", e)
                errors += 1
                continue
        finally:
            try:
                tpath.unlink()
            except FileNotFoundError:
                pass

        if verdict.ok:
            # Append canonical (F1) — never the raw attacker-authored line.
            with host_path.open("a") as fh:
                fh.write(canonical_line + "\n")
            approved += 1
        else:
            quarantine_record(project_dir, canonical, verdict.reason, verdict.to_audit())
            logging.warning("quarantined (%s)", verdict.reason)
            quarantined += 1

    # Processed file: unlink (F3 — don't truncate the live file; we own this rotated copy).
    try:
        rotated_file.unlink()
    except FileNotFoundError:
        pass
    return approved, quarantined, errors


def sync_project(project_dir: Path) -> None:
    logging.info("project: %s", project_dir.name)
    jsonl_files = list((project_dir / "homunculus").rglob("observations.jsonl"))
    if not jsonl_files:
        logging.info("  no observations files")
        return
    for jf in jsonl_files:
        rotated = rotate_jsonl(jf)
        if rotated is None:
            continue
        try:
            a, q, e = process_rotated(rotated, project_dir)
        except Exception as err:
            logging.exception("processing %s failed: %s", rotated, err)
            # Move the rotated file into quarantine so we don't keep reprocessing.
            qdest = project_dir / "quarantine" / rotated.name
            qdest.parent.mkdir(parents=True, exist_ok=True)
            shutil.move(str(rotated), qdest)
            continue
        logging.info("  %s: approved=%d quarantined=%d errors=%d",
                     jf.relative_to(project_dir), a, q, e)


def main() -> int:
    logging.basicConfig(
        level=os.environ.get("CL_SYNC_LOG", "INFO"),
        format="%(asctime)s claude-cl-sync %(levelname)s %(message)s",
    )
    # F9: fail-closed self-test before touching anything.
    smoke_test()

    if not STAGING_ROOT.exists():
        logging.info("no staging root: %s — nothing to do", STAGING_ROOT)
        return 0
    project_dirs = [d for d in STAGING_ROOT.iterdir() if d.is_dir()]
    if not project_dirs:
        logging.info("no projects in staging")
        return 0
    for pd in project_dirs:
        try:
            sync_project(pd)
        except Exception as e:
            logging.exception("project %s failed: %s", pd.name, e)
    return 0


if __name__ == "__main__":
    sys.exit(main())
