#!/usr/bin/env bash
# Launch the ToB devcontainer for a repo with a per-project GitHub App
# installation token mounted read-only at /run/gh-token/token.
#
# Usage: claude-sandbox [repo-path]
#   repo-path defaults to the current directory.
#
# One-time setup:
#   - Create GitHub App, install it on account (Phase 1 — GitHub UI).
#   - Drop private key to ~/.config/github-app/app.pem (chmod 600).
#   - Populate APP_ID and INSTALLATION_ID in ~/.config/github-app/config.
#   - Enable gh-token.timer: systemctl --user enable --now gh-token.timer.

set -euo pipefail

CONFIG="${GH_APP_CONFIG:-$HOME/.config/github-app/config}"
[ -r "$CONFIG" ] || { echo "claude-sandbox: cannot read $CONFIG" >&2; exit 1; }
# shellcheck disable=SC1090
. "$CONFIG"

: "${APP_ID:?APP_ID not set}"
: "${INSTALLATION_ID:?INSTALLATION_ID not set}"
: "${KEY_PATH:?KEY_PATH not set}"
: "${TOKEN_ROOT:?TOKEN_ROOT not set}"

if [ "$APP_ID" = "FILL_ME_IN" ] || [ "$INSTALLATION_ID" = "FILL_ME_IN" ]; then
    echo "claude-sandbox: APP_ID / INSTALLATION_ID not populated in $CONFIG" >&2
    exit 1
fi
[ -r "$KEY_PATH" ] || { echo "claude-sandbox: cannot read $KEY_PATH" >&2; exit 1; }

for bin in devc devcontainer jq curl openssl; do
    command -v "$bin" >/dev/null || { echo "claude-sandbox: missing $bin in PATH" >&2; exit 1; }
done

REPO_PATH="${1:-$PWD}"
REPO_PATH=$(cd "$REPO_PATH" && pwd)
cd "$REPO_PATH"

REMOTE_URL=$(git remote get-url origin 2>/dev/null) || {
    echo "claude-sandbox: $REPO_PATH has no 'origin' remote" >&2
    exit 1
}

# Parse github.com owner/name from HTTPS or SSH URL.
SLUG=$(printf '%s' "$REMOTE_URL" \
    | sed -E 's|^git@github\.com:|https://github.com/|' \
    | sed -E 's|^https://github\.com/||; s|\.git$||')

case "$SLUG" in
    */*) ;;
    *) echo "claude-sandbox: could not parse github owner/name from $REMOTE_URL" >&2; exit 1 ;;
esac

OWNER="${SLUG%%/*}"
NAME="${SLUG##*/}"

# Project identifier used by devcontainer and by our token dir.
# Must match ${localWorkspaceFolderBasename} — which is basename of REPO_PATH.
PROJECT=$(basename "$REPO_PATH")
SANDBOX_DIR="$TOKEN_ROOT/$PROJECT"

b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }

now=$(date +%s)
exp=$((now + 540))
header=$(printf '{"alg":"RS256","typ":"JWT"}' | b64url)
payload=$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' "$((now - 60))" "$exp" "$APP_ID" | b64url)
signing_input="${header}.${payload}"
sig=$(printf '%s' "$signing_input" | openssl dgst -sha256 -sign "$KEY_PATH" | b64url)
JWT="${signing_input}.${sig}"

# Two-step: /repos/... can't be called with App JWT (Bearer auth rejects it).
# 1) Mint a broad installation token (no repository_ids) on host.
# 2) Use it to list installation repos, pick matching full_name, get id.
# 3) Discard broad token — never handed to sandbox.
# Auth header kept off argv/env: written to a 0600 tempfile, curl reads via @file.
AUTH_FILE=$(mktemp) && chmod 600 "$AUTH_FILE" || { echo "claude-sandbox: tempfile" >&2; exit 1; }
trap 'rm -f "$AUTH_FILE"' EXIT INT TERM

printf 'Authorization: Bearer %s' "$JWT" > "$AUTH_FILE"
BROAD_TOKEN=$(curl -sS --fail-with-body -X POST \
    -H "@$AUTH_FILE" \
    -H "Accept: application/vnd.github+json" \
    -H "X-GitHub-Api-Version: 2022-11-28" \
    "https://api.github.com/app/installations/$INSTALLATION_ID/access_tokens" \
    | jq -r '.token // empty')

[ -n "$BROAD_TOKEN" ] || { echo "claude-sandbox: could not mint broad installation token (check APP_ID / INSTALLATION_ID / key)" >&2; exit 1; }

# Replace auth file contents with broad token; argv still hides it.
printf 'Authorization: token %s' "$BROAD_TOKEN" > "$AUTH_FILE"
unset BROAD_TOKEN

# Paginate /installation/repositories until we find $OWNER/$NAME.
# Upper bound: GitHub installations max ~100k repos → 1000 pages at per_page=100.
# A hard cap of 200 pages (20k repos) is well beyond solo-dev reality and stops
# a buggy/hostile upstream from looping the launcher forever.
REPO_ID=""
page=1
MAX_PAGE=200
while :; do
    response=$(curl -sS --fail-with-body \
        -H "@$AUTH_FILE" \
        -H "Accept: application/vnd.github+json" \
        -H "X-GitHub-Api-Version: 2022-11-28" \
        "https://api.github.com/installation/repositories?per_page=100&page=$page")
    found=$(printf '%s' "$response" | jq -r --arg slug "$OWNER/$NAME" '.repositories[]? | select(.full_name == $slug) | .id')
    if [ -n "$found" ]; then
        REPO_ID="$found"
        break
    fi
    count=$(printf '%s' "$response" | jq -r '.repositories | length // 0')
    [ "$count" -lt 100 ] && break
    page=$((page + 1))
    if [ "$page" -gt "$MAX_PAGE" ]; then
        echo "claude-sandbox: hit pagination cap of $MAX_PAGE pages without finding $OWNER/$NAME — bailing" >&2
        break
    fi
done
# Scrub + unlink immediately; trap handles the (now empty) file on exit.
: > "$AUTH_FILE"
rm -f "$AUTH_FILE"

[ -n "$REPO_ID" ] || { echo "claude-sandbox: $OWNER/$NAME not in this App installation's allowlist — add it at github.com/settings/installations/$INSTALLATION_ID" >&2; exit 1; }

mkdir -p "$SANDBOX_DIR"
chmod 700 "$SANDBOX_DIR"
printf '%s' "$REPO_ID" > "$SANDBOX_DIR/repo_id"

# Seed initial token so container sees it on first launch.
mint-gh-token || { echo "claude-sandbox: initial token mint failed" >&2; exit 1; }

# Install ToB template if repo has no .devcontainer yet.
if [ ! -d "$REPO_PATH/.devcontainer" ]; then
    echo "claude-sandbox: installing devcontainer template into $REPO_PATH/.devcontainer/" >&2
    devc template "$REPO_PATH"
fi

DC_JSON="$REPO_PATH/.devcontainer/devcontainer.json"
[ -f "$DC_JSON" ] || { echo "claude-sandbox: $DC_JSON missing after template install" >&2; exit 1; }

# Patch devcontainer.json idempotently:
#   - Add bind mount for per-project token dir (portable via localEnv+basename).
#   - Append our git credential helper setup to postCreateCommand.
#   - Append firewall init to postCreateCommand.
# Existing mounts/commands are preserved.

# Build mount list. Token dir always required (created above). Other sources
# only contributed if present on host, so Docker doesn't silently create empty
# dirs or fail the run with "bind source does not exist".
MOUNTS_JSON=$(jq -n '[]')
add_mount() {
    local src="$1" target="$2" host_path="$3"
    if [ -e "$host_path" ]; then
        MOUNTS_JSON=$(printf '%s' "$MOUNTS_JSON" | jq --arg m "$src" '. + [$m]')
    else
        echo "claude-sandbox: skipping mount (host missing): $host_path → $target" >&2
    fi
}

# Token dir (always present — just created).
MOUNTS_JSON=$(printf '%s' "$MOUNTS_JSON" | jq \
    --arg m 'source=${localEnv:HOME}/.cache/gh-tokens/${localWorkspaceFolderBasename},target=/run/gh-token,type=bind,readonly' \
    '. + [$m]')

add_mount 'source=${localEnv:HOME}/Repos/token-optimizer,target=/opt/token-optimizer,type=bind,readonly' \
    /opt/token-optimizer "$HOME/Repos/token-optimizer"

# Selective read-only mounts of host ~/.claude/ — share global config/skills.
# NOT mounted: .credentials.json, projects/, memory/, settings.local.json,
# todos/, shell-snapshots/, statsig/, token-optimizer/.
add_mount 'source=${localEnv:HOME}/.claude/CLAUDE.md,target=/home/vscode/.claude/CLAUDE.md,type=bind,readonly' \
    /home/vscode/.claude/CLAUDE.md "$HOME/.claude/CLAUDE.md"
add_mount 'source=${localEnv:HOME}/.claude/skills,target=/home/vscode/.claude/skills,type=bind,readonly' \
    /home/vscode/.claude/skills "$HOME/.claude/skills"
add_mount 'source=${localEnv:HOME}/.claude/plugins,target=/home/vscode/.claude/plugins,type=bind,readonly' \
    /home/vscode/.claude/plugins "$HOME/.claude/plugins"
add_mount 'source=${localEnv:HOME}/.claude/agents,target=/home/vscode/.claude/agents,type=bind,readonly' \
    /home/vscode/.claude/agents "$HOME/.claude/agents"
add_mount 'source=${localEnv:HOME}/.claude/commands,target=/home/vscode/.claude/commands,type=bind,readonly' \
    /home/vscode/.claude/commands "$HOME/.claude/commands"

POST_TAIL='bash /workspace/.devcontainer/claude-sandbox-post.sh'

TMP=$(mktemp)
jq --argjson our_mounts "$MOUNTS_JSON" --arg tail "$POST_TAIL" '
    .mounts = (
        ((.mounts // []) | map(select(
            (contains("target=/run/gh-token") | not) and
            (contains("target=/opt/token-optimizer") | not) and
            (contains("target=/home/vscode/.claude/CLAUDE.md") | not) and
            (contains("target=/home/vscode/.claude/skills/continuous-learning-v2") | not) and
            (contains("target=/home/vscode/.claude/skills,") | not) and
            (contains("target=/home/vscode/.claude/plugins") | not) and
            (contains("target=/home/vscode/.claude/agents") | not) and
            (contains("target=/home/vscode/.claude/commands") | not) and
            (contains("target=/home/vscode/.claude/homunculus") | not)
        )))
        + $our_mounts
    )
    | .remoteEnv = ((.remoteEnv // {}) + {
        HTTP_PROXY:  "http://172.17.0.1:8888",
        HTTPS_PROXY: "http://172.17.0.1:8888",
        NO_PROXY:    "localhost,127.0.0.1"
    })
    | .containerEnv = ((.containerEnv // {}) | del(.CLV2_CONFIG))
    | .postCreateCommand = (
        if (.postCreateCommand // "" | type) == "string" and (.postCreateCommand // "" | contains($tail)) then
            .postCreateCommand
        else
            ((.postCreateCommand // "") | if . == "" then $tail else . + " && " + $tail end)
        end
    )
' "$DC_JSON" > "$TMP" && mv "$TMP" "$DC_JSON"

# Drop in the post-create helper (idempotent — always overwrite).
POST_SCRIPT="$REPO_PATH/.devcontainer/claude-sandbox-post.sh"
cat > "$POST_SCRIPT" <<'EOS'
#!/usr/bin/env bash
# Runs once at container creation (postCreateCommand).
set -euo pipefail

# Git credential helper: reads per-project installation token from the
# read-only mount at /run/gh-token/token. Fails loudly if the file is
# missing/empty instead of emitting an empty password and 401'ing silently.
git config --global credential.helper '!f() { t=/run/gh-token/token; [ -s "$t" ] || { echo "claude-sandbox: $t missing or empty (gh-token.timer dead? token dir cleaned up?)" >&2; exit 1; }; printf "username=x-access-token\npassword=%s\n" "$(cat "$t")"; }; f'

# Egress firewall (Layer 2). Idempotent-ish: drops everything else, allows
# only github + configured registries. Re-running flushes and re-applies.
if [ -x /workspace/.devcontainer/claude-sandbox-firewall.sh ]; then
    sudo /workspace/.devcontainer/claude-sandbox-firewall.sh || true
fi

mkdir -p "$HOME/.claude"
if [ ! -f "$HOME/.claude/settings.json" ]; then
    echo '{}' > "$HOME/.claude/settings.json"
fi

# Token-optimizer: enable the plugin from the read-only mount at /opt/token-optimizer.
if [ -d /opt/token-optimizer ]; then
    TMP=$(mktemp)
    jq '
        .enabledPlugins["token-optimizer@alexgreensh-token-optimizer"] = true
        | .extraKnownMarketplaces["alexgreensh-token-optimizer"] = {
            source: { source: "directory", path: "/opt/token-optimizer" }
          }
        | .statusLine = {
            type: "command",
            command: "node /opt/token-optimizer/skills/token-optimizer/scripts/statusline.js"
          }
    ' "$HOME/.claude/settings.json" > "$TMP" && mv "$TMP" "$HOME/.claude/settings.json"
fi
EOS
chmod +x "$POST_SCRIPT"

FIREWALL_SCRIPT="$REPO_PATH/.devcontainer/claude-sandbox-firewall.sh"
cat > "$FIREWALL_SCRIPT" <<'EOS'
#!/usr/bin/env bash
# Per-container egress lockdown. Everything direct is blocked; all outbound
# HTTP(S) must go through the host-side hostname-allowlisted proxy at
# 172.17.0.1:8888 (claude-sandbox-proxy). DNS is allowed so container apps can
# resolve the destination before CONNECT; that lookup does not itself egress
# anything useful.
set -euo pipefail

iptables -F OUTPUT
iptables -P OUTPUT DROP

# Loopback.
iptables -A OUTPUT -o lo -j ACCEPT

# DNS: restrict to the nameservers actually configured in the container.
# Only accept numeric (IPv4) nameserver literals — skip hostnames, IPv6
# link-local, and anything else that would either error iptables or silently
# pin a resolved address. IPv6 DNS is blocked by the v6 default-DROP below.
while read -r _ ns _; do
    case "$ns" in
        ''|'#'*) continue ;;
        *[!0-9.]*) continue ;;  # non-numeric → skip (hostname, v6, etc.)
    esac
    iptables -A OUTPUT -d "$ns" -p udp --dport 53 -j ACCEPT
    iptables -A OUTPUT -d "$ns" -p tcp --dport 53 -j ACCEPT
done < <(grep -E '^nameserver ' /etc/resolv.conf || true)

# Return traffic for established connections.
iptables -A OUTPUT -m state --state ESTABLISHED,RELATED -j ACCEPT

# The egress proxy on the docker bridge. All HTTP(S) egress funnels here.
iptables -A OUTPUT -d 172.17.0.1 -p tcp --dport 8888 -j ACCEPT

# IPv6: default-DROP everything. The proxy only listens on v4, and no
# allowlisted destination needs IPv6 from inside the container. Leaving v6
# default-ACCEPT would silently bypass the v4 allowlist.
if command -v ip6tables >/dev/null 2>&1; then
    ip6tables -F OUTPUT 2>/dev/null || true
    ip6tables -P OUTPUT DROP 2>/dev/null || true
    ip6tables -A OUTPUT -o lo -j ACCEPT 2>/dev/null || true
fi

# Nothing else. HTTPS_PROXY / HTTP_PROXY in the env steers well-behaved apps
# through the proxy; anything trying to bypass lands in DROP.
EOS
chmod +x "$FIREWALL_SCRIPT"

# Continuous-learning-v2 was removed; drop its leftover container config.
rm -f "$REPO_PATH/.devcontainer/cl-v2-container-config.json"

# P1: rebuild on drift. Hash the things that actually affect container state:
# post + firewall scripts PLUS devcontainer.json mounts/env (changes to these
# only take effect on a fresh container). If any changed, force rebuild.
SIG_FILE="$SANDBOX_DIR/.script-sig"
# Hash every devcontainer.json key whose change requires a rebuild to take
# effect, so a repo committing e.g. runArgs=["--network=host"] triggers a
# rebuild (and is visible via diff) instead of silently degrading egress.
CUR_SIG=$(
    {
        cat "$POST_SCRIPT" "$FIREWALL_SCRIPT"
        jq -S '{
            mounts, remoteEnv, containerEnv, postCreateCommand,
            runArgs, features, build, capAdd, securityOpt,
            initializeCommand, onCreateCommand, updateContentCommand,
            workspaceMount, workspaceFolder, remoteUser, privileged
        }' "$DC_JSON"
    } | sha256sum | cut -d' ' -f1
)
PREV_SIG=""
[ -f "$SIG_FILE" ] && PREV_SIG=$(cat "$SIG_FILE")

NEEDS_REBUILD=0
if [ "$CUR_SIG" != "$PREV_SIG" ]; then
    NEEDS_REBUILD=1
    echo "claude-sandbox: devcontainer config or scripts changed — rebuilding container" >&2
fi

echo "claude-sandbox: starting devcontainer for $OWNER/$NAME (token dir: $SANDBOX_DIR)" >&2

if [ "$NEEDS_REBUILD" = 1 ]; then
    devc rebuild "$REPO_PATH"
    rc=$?
else
    devc up "$REPO_PATH"
    rc=$?
fi

[ $rc -eq 0 ] && printf '%s' "$CUR_SIG" > "$SIG_FILE"
exit $rc
