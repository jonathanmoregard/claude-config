# Ledger data: sampled tool inputs (redacted, but local-only regardless).
*.jsonl
hook-errors.log
digest-latest.json
digest-prev.json
decided.json
.evaluate.lock
# run-tests.sh builds this at permission-ledger/.testhome (TESTHOME="$S/.testhome",
# where S is this directory), not under tests/ — the old `tests/.testhome/` path
# never matched, so every harness run left the throwaway HOME untracked.
.testhome/
__pycache__/
# Test-run artifacts (outputs, not sources)
tests/crontab.*
tests/pass*.out
tests/settings.after*.json
tests/fake-crontab.txt
tests/stage/
